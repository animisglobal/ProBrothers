---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isAbout = pathname.startsWith('/about');
const isContact = pathname.startsWith('/contact');
const isServices = pathname.startsWith('/services');
const isProjects = pathname.startsWith('/projects');
const isLocations = pathname.startsWith('/locations');
const isBlog = pathname.startsWith('/blog');
---
<!-- ===== Header / Nav ===== -->
<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="ProBrothers Construction home">
      <img src="/assets/img/logo.webp" alt="ProBrothers Construction" class="brand__logo" width="201" height="75" />
    </a>

    <nav class="nav" id="nav" aria-label="Main navigation">
      <button class="nav__close" id="navClose" aria-label="Close menu" type="button">
        <span aria-hidden="true">&times;</span>
      </button>
      <ul class="nav__list">
        <li><a href="/" class={isHome ? 'active' : ''}>Home</a></li>
        <li><a href="/about/" class={isAbout ? 'active' : ''}>About</a></li>
        <li class="has-sub">
          <a href="/services/" class={isServices ? 'active' : ''}>Services</a>
          <button class="submenu-toggle" type="button" aria-label="Toggle Services submenu" aria-expanded="false">
            <span aria-hidden="true"></span>
          </button>
          <ul class="submenu">
            <li><a href="/services/trim/">Trim</a></li>
            <li><a href="/services/cabinets/">Cabinets</a></li>
            <li><a href="/services/remodeling/">Remodeling</a></li>
            <li><a href="/services/additions/">Additions</a></li>
            <li><a href="/services/construction-services/">Construction Services</a></li>
            <li><a href="/services/windows-and-doors/">Windows &amp; Doors</a></li>
          </ul>
        </li>
        <li class="has-sub">
          <a href="/projects/" class={isProjects ? 'active' : ''}>Projects</a>
          <button class="submenu-toggle" type="button" aria-label="Toggle Projects submenu" aria-expanded="false">
            <span aria-hidden="true"></span>
          </button>
          <ul class="submenu">
            <li><a href="/projects/trim/">Trim</a></li>
            <li><a href="/projects/cabinets/">Cabinets</a></li>
            <li><a href="/projects/remodeling/">Remodeling</a></li>
            <li><a href="/projects/windows-doors/">Windows &amp; Doors</a></li>
          </ul>
        </li>
        <li class="has-sub">
          <a href="/locations/" class={isLocations ? 'active' : ''}>Locations</a>
          <button class="submenu-toggle" type="button" aria-label="Toggle Locations submenu" aria-expanded="false">
            <span aria-hidden="true"></span>
          </button>
          <ul class="submenu submenu--cols">
            <li><a href="/locations/media/">Media, PA</a></li>
            <li><a href="/locations/west-chester/">West Chester, PA</a></li>
            <li><a href="/locations/glen-mills/">Glen Mills, PA</a></li>
            <li><a href="/locations/philadelphia/">Philadelphia, PA</a></li>
            <li><a href="/locations/kennett-square/">Kennett Square, PA</a></li>
            <li><a href="/locations/phoenixville/">Phoenixville, PA</a></li>
            <li><a href="/locations/rehoboth/">Rehoboth, DE</a></li>
            <li><a href="/locations/greenville/">Greenville, DE</a></li>
            <li><a href="/locations/malvern/">Malvern, PA</a></li>
            <li><a href="/locations/springfield/">Springfield, PA</a></li>
            <li><a href="/locations/marple/">Marple, PA</a></li>
            <li><a href="/locations/newtown/">Newtown, PA</a></li>
            <li><a href="/locations/nether-providence/">Nether Providence, PA</a></li>
            <li><a href="/locations/king-of-prussia/">King of Prussia, PA</a></li>
            <li><a href="/locations/allentown/">Allentown, PA</a></li>
          </ul>
        </li>
        <li><a href="/blog/" class={isBlog ? 'active' : ''}>Blog</a></li>
        <li><a href="/contact/" class={isContact ? 'active' : ''}>Contact</a></li>
      </ul>
    </nav>

    <a href="/contact/" class="btn btn--accent header__cta">Get a Quote</a>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
