---
import Topbar from '../components/Topbar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExitPopup from '../components/ExitPopup.astro';

// Per-page metadata. Defaults reproduce the original index.html exactly.
const {
  title = 'ProBrothers Construction — General & Home Remodeling Contractor | Media, PA',
  description = "ProBrothers Construction — full-service residential & commercial contractor in Media, PA. 15+ years of trim, cabinetry, remodeling, additions & window work.",
  canonical = 'https://probrothers.com/',
  ogTitle = 'ProBrothers Construction — General & Home Remodeling Contractor | Media, PA',
  ogDescription = 'Full-service residential & commercial construction and remodeling. Trim, cabinets, additions, windows & doors in Media, PA. Free quote within one business day.',
  ogUrl = 'https://probrothers.com/',
  ogImage = 'https://probrothers.com/assets/img/hero-trim.webp',
  twitterTitle = 'ProBrothers Construction — General & Home Remodeling Contractor | Media, PA',
  twitterDescription = 'Full-service residential & commercial construction and remodeling in Media, PA. Free quote within one business day.',
  twitterImage = 'https://probrothers.com/assets/img/hero-trim.webp',
  preloadHero = true,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SGDC0JHS43"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SGDC0JHS43');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#25282A" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/img/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  <!-- Open Graph / social -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ProBrothers Construction" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={twitterTitle} />
  <meta name="twitter:description" content={twitterDescription} />
  <meta name="twitter:image" content={twitterImage} />
  <meta name="twitter:site" content="@probrothers" />

  <!-- LocalBusiness structured data (rich results + local SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "@id": "https://probrothers.com/#business",
    "name": "ProBrothers Construction",
    "alternateName": "ProBrothers",
    "image": "https://probrothers.com/assets/img/hero-trim.webp",
    "logo": "https://probrothers.com/assets/img/logo.png",
    "url": "https://probrothers.com/",
    "telephone": "+1-484-745-4097",
    "email": "info@probrothers.com",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "7 Blackhorse Ln",
      "addressLocality": "Media",
      "addressRegion": "PA",
      "postalCode": "19063",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 39.917,
      "longitude": -75.387
    },
    "areaServed": ["Media", "West Chester", "Philadelphia", "Newtown Square", "Allentown", "Marple", "King of Prussia", "Nether Providence", "Springfield", "Malvern", "Greenville", "Glen Mills", "Kennett Square", "Newtown", "Phoenixville"],
    "description": "Full-service residential and commercial construction and remodeling company with over 15 years of experience, serving 15 cities across Delaware County and the Main Line, PA. Trim, cabinets, remodeling, additions, windows & doors.",
    "slogan": "15+ years of expert craftsmanship · serving 15 cities across Delaware County & the Main Line, PA",
    "knowsAbout": ["Home remodeling", "Kitchen remodeling", "Custom cabinetry", "Trim carpentry", "Home additions", "Window and door installation", "Residential construction", "Commercial construction"],
    "foundingDate": "2009",
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "Pennsylvania Home Improvement Contractor Registration",
      "credentialCategory": "license",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Pennsylvania Office of Attorney General",
        "url": "https://www.attorneygeneral.gov/protect-yourself/home-improvement-contractor/"
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "3",
      "bestRating": "5"
    },
    "openingHours": "Mo-Sa 08:00-18:00",
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    }],
    "sameAs": [
      "https://www.instagram.com/probrothersconstructionn1",
      "https://www.facebook.com/profile.php?id=100080301824582",
      "https://www.youtube.com/@probrothersconstruction",
      "https://www.yelp.com/biz/probrothers-media-2",
      "https://maps.app.goo.gl/Wtwfh7T95hxaF5kj6"
    ]
  })} />

  <!-- Preconnect not needed (all assets self-hosted) -->
  <!-- Preload the LCP hero image so the browser fetches it immediately, before CSS/JS parse -->
  {preloadHero && (
    <link rel="preload" as="image" href="/assets/img/slide-trim.webp"
          imagesizes="100vw" fetchpriority="high" />
  )}
  <link rel="preload" href="/assets/fonts/raleway-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- @font-face inlined to remove a render-blocking request + a network hop -->
  <style>
    @font-face{
      font-family:'Raleway';font-style:normal;font-weight:300 900;font-display:swap;
      src:url('/assets/fonts/raleway-latin.woff2') format('woff2');
      unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
    }
  </style>

  <link rel="stylesheet" href="/styles.css" />
  <slot name="head" />
</head>
<body>

  <!-- ===== Scroll progress bar ===== -->
  <div class="scroll-progress" id="scrollProgress"></div>

  <Topbar />
  <Header />

  <slot />

  <Footer />

  <ExitPopup />

  <script src="/script.js" defer></script>
</body>
</html>
