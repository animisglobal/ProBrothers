<script>
/* ---------- Team member popup ---------- */
(function teamPopup() {
  const modal = document.getElementById('teamModal');
  const cards = document.querySelectorAll('.team__card[data-bio]');
  if (!modal || !cards.length) return;

  const photoBox = modal.querySelector('#teamModalPhoto');
  const nameEl = modal.querySelector('#teamModalName');
  const roleEl = modal.querySelector('#teamModalRole');
  const bioEl = modal.querySelector('#teamModalBio');
  const closeEls = modal.querySelectorAll('[data-team-close]');
  let lastFocused = null;

  function open(card) {
    lastFocused = card;
    const name = card.querySelector('.team__info h3')?.textContent.trim() || '';
    const role = card.querySelector('.team__info span')?.textContent.trim() || '';
    const bio = card.getAttribute('data-bio') || '';
    const img = card.querySelector('.team__photo img');
    const initials = card.querySelector('.team__photo--initials span');

    nameEl.textContent = name;
    roleEl.textContent = role;

    bioEl.innerHTML = '';
    bio.split('|').forEach(part => {
      const text = part.trim();
      if (!text) return;
      const p = document.createElement('p');
      p.textContent = text;
      bioEl.appendChild(p);
    });

    photoBox.className = 'team-modal__photo';
    photoBox.innerHTML = '';
    if (img) {
      const clone = document.createElement('img');
      clone.src = img.currentSrc || img.src;
      clone.alt = name;
      photoBox.appendChild(clone);
    } else if (initials) {
      photoBox.classList.add('team-modal__photo--initials');
      const span = document.createElement('span');
      span.textContent = initials.textContent;
      photoBox.appendChild(span);
    }

    modal.hidden = false;
    requestAnimationFrame(() => modal.classList.add('open'));
    document.body.classList.add('modal-open');
    modal.querySelector('.team-modal__close')?.focus();
  }

  function close() {
    modal.classList.remove('open');
    document.body.classList.remove('modal-open');
    setTimeout(() => { modal.hidden = true; }, 300);
    if (lastFocused) lastFocused.focus();
  }

  cards.forEach(card => {
    card.addEventListener('click', () => open(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(card); }
    });
  });
  closeEls.forEach(el => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('open')) close();
  });
})();
</script>
