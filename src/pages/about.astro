---
import Layout from '../layouts/Layout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://probrothers.com/about/",
      "name": "About ProBrothers",
      "url": "https://probrothers.com/about/",
      "description": "With over 15 years of experience, ProBrothers has established itself as a leader in the construction industry, known for delivering exceptional quality and craftsmanship.",
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://probrothers.com/" },
      "breadcrumb": { "@id": "https://probrothers.com/about/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://probrothers.com/about/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://probrothers.com/" },
        { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://probrothers.com/about/" }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://probrothers.com/#organization",
      "name": "ProBrothers Construction",
      "alternateName": "ProBrothers",
      "url": "https://probrothers.com/",
      "logo": "https://probrothers.com/assets/img/logo.png",
      "telephone": "+1-484-745-4097",
      "foundingDate": "2009",
      "numberOfEmployees": 8,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "7 Blackhorse Ln",
        "addressLocality": "Media",
        "addressRegion": "PA",
        "postalCode": "19063",
        "addressCountry": "US"
      },
      "member": [
        { "@type": "Person", "name": "Daniil Akulov", "jobTitle": "Owner & Founder" },
        { "@type": "Person", "name": "Vitaliy Akulov", "jobTitle": "Co-Owner & Project Manager" },
        { "@type": "Person", "name": "Alex", "jobTitle": "Site Supervisor" },
        { "@type": "Person", "name": "Kristian Vainraukh", "jobTitle": "Carpenter" },
        { "@type": "Person", "name": "Marsel Akulov", "jobTitle": "Sales & Carpenter" },
        { "@type": "Person", "name": "James Akulov", "jobTitle": "Carpenter" },
        { "@type": "Person", "name": "Zhena Burlakov", "jobTitle": "Carpenter" },
        { "@type": "Person", "name": "Marina Akulov", "jobTitle": "Accountant" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://probrothers.com/about/#faq",
      "isPartOf": { "@id": "https://probrothers.com/about/" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long has ProBrothers been in business?",
          "acceptedAnswer": { "@type": "Answer", "text": "ProBrothers has been serving homeowners and businesses for over 15 years, completing 135+ construction and remodeling projects across Media, Delaware County, and the Main Line in Pennsylvania." }
        },
        {
          "@type": "Question",
          "name": "Where is ProBrothers located and what areas do you serve?",
          "acceptedAnswer": { "@type": "Answer", "text": "ProBrothers is headquartered at 7 Blackhorse Ln, Media, PA 19063. We serve 15 cities across Delaware County and the Main Line, including Media, West Chester, King of Prussia, Glen Mills, Malvern, Kennett Square, Newtown Square, Marple, Springfield, Phoenixville, Allentown, Philadelphia, and Greenville and Rehoboth in Delaware." }
        },
        {
          "@type": "Question",
          "name": "Is ProBrothers a full-service general contractor?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. ProBrothers is a full-service residential and commercial general contractor. We self-perform the core trades — trim carpentry, custom cabinetry, home remodeling, additions, new construction, and window and door installation — so every project is managed in-house from design through final installation." }
        },
        {
          "@type": "Question",
          "name": "What makes ProBrothers different from other contractors?",
          "acceptedAnswer": { "@type": "Answer", "text": "ProBrothers combines quality workmanship, superior knowledge, and competitive pricing, backed by an 8-person in-house team led by founder Daniil Akulov, who has over 20 years of carpentry experience. Clients consistently rate us 5.0, and we return a free, detailed quote within one business day." }
        },
        {
          "@type": "Question",
          "name": "How quickly can I get a quote from ProBrothers?",
          "acceptedAnswer": { "@type": "Answer", "text": "We provide a free, no-obligation quote within one business day of your enquiry. Call (484) 745-4097 or email info@probrothers.com to start your project in Media, PA or anywhere across Delaware County and the Main Line." }
        }
      ]
    }
  ]
};
---
<Layout
  title="About ProBrothers | 15+ Yrs | Media, PA Contractor"
  description="Family-run general contractor in Media, PA since 2009. 15+ years of craftsmanship, 5.0 rating, 135+ projects. Meet Daniil and the ProBrothers team."
  canonical="https://probrothers.com/about/"
  ogTitle="About ProBrothers | 15+ Yrs | Media, PA Contractor"
  ogDescription="Family-run general contractor in Media, PA since 2009. 15+ years of craftsmanship, 5.0 rating, 135+ projects. Meet Daniil and the ProBrothers team."
  ogUrl="https://probrothers.com/about/"
  ogImage="https://probrothers.com/assets/img/team/Marsel-Akulov-390x260.webp"
  twitterTitle="About ProBrothers | 15+ Yrs | Media, PA Contractor"
  twitterDescription="Family-run general contractor in Media, PA since 2009. 15+ years of craftsmanship, 5.0 rating, 135+ projects. Meet Daniil and the ProBrothers team."
  twitterImage="https://probrothers.com/assets/img/team/Marsel-Akulov-390x260.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="ProBrothers team at a job site in Media, PA" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">About Us</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">About Us</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Industry Leaders in Construction &amp; Remodeling</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Industry Leaders ===== -->
  <section class="section about-leader" id="about-leader" aria-label="ProBrothers - Industry Leaders">
    <div class="container">
      <div class="about-leader__grid">
        <!-- Left column: text + bullets -->
        <div class="about-leader__text reveal" data-reveal="left">
          <span class="section__kicker">PROBROTHERS - INDUSTRY LEADERS</span>
          <h2 class="section__title">Industry Leaders</h2>
          <p class="about-leader__para">With over 15 years of experience, ProBrothers has established itself as a leader in the construction industry, known for delivering exceptional quality and craftsmanship. Our expertise includes home renovations, seamless additions, and building brand-new homes. ProBrothers operates as a full-service construction and remodeling company, offering trim carpentry, custom cabinets, interior remodeling, home additions, and window and door installation. The company focuses on planning, functional layouts, and executing projects that match how homes are actually used.</p>
          <ul class="about-leader__list" role="list">
            <li>We combine Quality Workmanship, Superior Knowledge and Low Prices</li>
            <li>We Can Ensure a Job is Done on Time and on Budget</li>
            <li>Proven Results for Setting Exceptional Standards in Cost Control</li>
            <li>Proffesional Service for Private and Commercial Customers</li>
            <li>15 Years Experience and a Real Focus on Customer Satisfaction</li>
          </ul>
        </div>
        <!-- Right column: value cards -->
        <div class="about-leader__cards reveal" data-reveal="right">
          <article class="value-card">
            <div class="value-card__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z"/>
              </svg>
            </div>
            <div class="value-card__content">
              <h3>BEST VALUE</h3>
              <p>We combine quality workmanship, superior knowledge and low prices to provide you with service unmatched by our competitors.</p>
            </div>
          </article>
          <article class="value-card">
            <div class="value-card__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </div>
            <div class="value-card__content">
              <h3>SAVING TIME</h3>
              <p>We have the experience, personel and resources to make the project run smoothly. We can ensure a job is done on time.</p>
            </div>
          </article>
          <article class="value-card">
            <div class="value-card__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/>
              </svg>
            </div>
            <div class="value-card__content">
              <h3>WITHIN BUDGET</h3>
              <p>Work with us involve a carefully planned series of steps, centered around a schedule we stick to and daily communication.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Why Choose Us ===== -->
  <section class="section why why-about" id="why-choose-us" aria-label="Why Choose Us">
    <div class="why__divider" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
        <path d="M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,45 L1440,0 L0,0 Z" />
      </svg>
    </div>
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker section__kicker--light">The ProBrothers Difference</span>
        <h2 class="section__title section__title--light">WHY CHOOSE US</h2>
      </div>
      <div class="why__grid">
        <div class="why__item reveal">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="why__num" data-count="15">0</div>
          <h3>Years of Professional Experience</h3>
        </div>
        <div class="why__item reveal" style="--d:.12s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="why__num" data-count="135">0</div>
          <h3>Completed Projects and Investments</h3>
        </div>
        <div class="why__item reveal" style="--d:.24s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="why__num" data-count="12">0</div>
          <h3>Skilled Professionals</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== What We Can Do ===== -->
  <section class="section what-we-do" id="what-we-do" aria-label="What We Can Do">
    <div class="container">
      <div class="what-we-do__layout">
        <div class="what-we-do__content reveal" data-reveal="left">
          <span class="section__kicker">Our Capabilities</span>
          <h2 class="section__title what-we-do__title">WHAT WE CAN DO</h2>
          <p>At ProBrothers, we offer a wide range of construction and remodeling services tailored to fit your unique vision. From custom trim carpentry and bespoke cabinetry to full-scale interior remodels, seamless home additions, brand-new construction, and energy-efficient window and door installations, our team handles every phase in-house. No job is too challenging for us&mdash;our passion for craftsmanship and attention to detail ensure that every aspect of your project is completed to the highest standards. From simple renovations to complex construction projects, we take pride in our meticulous approach and unwavering commitment to excellence. At ProBrothers, we believe in turning your dreams into reality, providing a level of service that exceeds expectations. When it comes to construction, there&rsquo;s only one choice: ProBrothers Construction.</p>
          <p>Let us bring your vision to life with our unparalleled expertise and dedication. Contact us today to discuss your project and discover how our experienced team can make your dream home a reality.</p>
          <a href="/contact/" class="btn btn--accent btn--lg" data-magnetic>Get a Free Quote</a>
        </div>
        <div class="what-we-do__image reveal" data-reveal="right">
          <img src="/assets/img/proj-mantle.webp" alt="ProBrothers trim and craftsmanship work" loading="lazy" width="750" height="500" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Our Team ===== -->
  <section class="section team" id="our-team" aria-label="Our Team">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">Meet the Experts</span>
        <h2 class="section__title">OUR TEAM</h2>
      </div>
      <div class="team__grid">
        <article id="daniil-akulov" class="team__card reveal" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="I’ve been working in construction for many years. Pro Brothers Construction is my company, and building has been a part of my life since I was a kid.|As the owner, my main responsibility is making sure every project runs smoothly from start to finish. I oversee the entire construction process, work closely with clients, coordinate our crews, solve problems, and make sure every detail meets our standards. My goal is to ensure every project is completed the right way—not just finished.|Construction has always been a family business for me. My father owned a construction company, and I grew up working alongside him on job sites. Those experiences taught me the value of hard work, craftsmanship, and treating every home with respect. Over the years, I realized I genuinely love building beautiful spaces and bringing our clients’ ideas to life.|Yes. We maintain OSHA safety training and hold the necessary contractor licenses to work in Pennsylvania, Delaware, and New York. We continually stay up to date with industry standards, safety practices, and building requirements.|Over the years, we’ve completed luxury renovations, custom kitchens, bathrooms, built-ins, millwork, whole-home remodels, commercial spaces, and high-end residential projects. Every project is different, and we enjoy taking on work that requires creativity, craftsmanship, and attention to detail.|One of the most memorable projects we’ve completed was a luxury penthouse renovation in Manhattan. We handled highly custom interior millwork, solid White Oak cabinetry, custom doors, wall panels, and many complex architectural details. It was challenging, but those are exactly the kinds of projects our team enjoys the most. The finished result exceeded expectations, and seeing a happy client at the end made all the hard work worthwhile.|My biggest priorities are quality, safety, communication, and cleanliness. Every project should be built exactly the way the homeowner envisioned it. We keep our job sites organized and safe, communicate with our clients throughout the process, and make sure there are no surprises. Building trust is just as important as building a beautiful finished product.|I’m a husband and the proud father of seven children. Some of my older sons already work alongside me, making Pro Brothers Construction a true family business. Outside of work, I enjoy riding dirt bikes, staying active, and running about six miles several times a week. Family, faith, and hard work are the values that guide both my life and my business.">
          <div class="team__photo">
            <img src="/assets/img/team/Daniel-390x260.webp" alt="Daniil Akulov &mdash; Owner &amp; Founder at ProBrothers" loading="lazy" width="390" height="260" />
          </div>
          <div class="team__info">
            <h3>Daniil Akulov</h3>
            <span>Owner &amp; Founder</span>
          </div>
        </article>
        <article class="team__card reveal" style="--d:.07s" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="I’ve been working in construction for over 20 years. As a co-owner of ProBrothers Construction, I’ve helped build the company by leading projects, solving complex challenges, and delivering high-quality craftsmanship from start to finish.|I’m known for taking on the projects that require careful planning and problem-solving. I enjoy finding practical solutions to difficult construction challenges while making sure every detail meets our standards. Whether it’s coordinating the team, working with clients, or handling complex installations, my goal is to make every project run smoothly.|Construction became my profession through years of hands-on experience. I discovered early on that I enjoy creating beautiful spaces and seeing ideas turn into reality. Every project has taught me something new and strengthened my passion for quality craftsmanship.|I am OSHA certified, but most of my experience comes from years of hands-on work in the field. I continually improve my skills by learning new building methods, products, and installation systems to stay current with today’s construction industry.|I’ve worked on luxury home renovations, custom kitchens, whole-home remodels, additions, custom millwork, built-in cabinetry, and high-end residential construction. I especially enjoy projects that require creative thinking and attention to detail.|One project I’m especially proud of was a luxury penthouse renovation that involved custom cabinetry, architectural millwork, and many unique design details. It challenged our entire team and pushed us to perform at our best. Seeing the finished result and a satisfied client made all the hard work worthwhile.|For me, the most important things are quality, communication, and trust. I believe every client deserves honesty, clear communication, and a finished product that exceeds expectations. My goal is not just to complete a project—but to complete it the right way.|I’m a husband, a proud father of seven children, and a grandfather. Outside of work, I enjoy spending time with my family, serving in my local church, and continually learning new skills. My faith, family, and commitment to excellence shape both my personal life and the way I approach every project.">
          <div class="team__photo">
            <img src="/assets/img/team/Vitaliy-390x260.webp" alt="Vitaliy Akulov &mdash; Co-Owner &amp; Project Manager at ProBrothers" loading="lazy" width="390" height="260" />
          </div>
          <div class="team__info">
            <h3>Vitaliy Akulov</h3>
            <span>Co-Owner &amp; Project Manager</span>
          </div>
        </article>
        <article class="team__card reveal" style="--d:.14s" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="I’ve been working in construction for over 15 years.|I’m a woodworker by trade, and I specialize in interior finish work, custom carpentry, maintenance, and solving on-site challenges. I enjoy working on detailed projects that require precision and craftsmanship, especially when we bring unique designer ideas to life.|To be honest, construction just became a natural part of my life. I’ve always enjoyed working with my hands and building things. Over the years, I discovered that I really enjoy taking on challenging custom projects—the more difficult and detailed the work, the more rewarding it is. That’s one of the reasons I love working at Pro Brothers.|Yes. I have completed OSHA safety training, and at Pro Brothers we work under all required licenses and insurance. Safety, professionalism, and quality are always part of every project we take on.|I’ve worked on a wide variety of residential remodeling projects, including custom kitchens, bathrooms, home additions, built-ins, trim work, and complete interior renovations. Every project teaches you something new, and I enjoy being part of transforming a house into a home.|It’s hard to choose just one because every project is important to us. We put our heart into every job, no matter the size. Seeing a finished project come together and knowing the homeowner is happy with the result is what makes the work worthwhile.|As a site supervisor, my priorities are keeping the job site safe, clean, and organized while making sure the work meets our standards. I also believe communication is key. At the end of the day, our biggest goal is a satisfied client who feels confident throughout the entire construction process.|I’m married and the proud father of four children. My family and I love traveling together and exploring new places whenever we have the opportunity. Spending quality time with them is the best way for me to recharge before the next project.">
          <div class="team__photo team__photo--initials" aria-hidden="true">
            <span>A</span>
          </div>
          <div class="team__info">
            <h3>Alex</h3>
            <span>Site Supervisor</span>
          </div>
        </article>
        <article class="team__card reveal" style="--d:.21s" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="Once an apprentice, Kristian is now trained carpenter, ready to make your dreams become a reality.|Pro Brothers&#x27; workers are trained to notice the details, work carefully, and bring only the best results to our clients. If you want integrity, honesty, and a hard working working team, you have come to the right place.">
          <div class="team__photo">
            <img src="/assets/img/team/Kristian-390x260.webp" alt="Kristian Vainraukh &mdash; Carpenter at ProBrothers" loading="lazy" width="390" height="260" />
          </div>
          <div class="team__info">
            <h3>Kristian Vainraukh</h3>
            <span>Carpenter</span>
          </div>
        </article>
        <article class="team__card reveal" style="--d:.28s" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="I have officially started working for ProBrothers since 2023, but I have been working during summer breaks since 2020. However, ProBrothers being my Father’s company, means I have actually been working since I could walk. What started as bringing the correct tool on a random Saturday home “renovation”, eventually led to me falling in love with the trade.|My specialty is trim and cabinets, but overall I am a well rounded carpenter. I especially enjoy when I get to integrate tech into a project, like home automation, LED’s, sensors, and so on. If you’ve got something new, I always love learning a new skill.|Yes. I have completed OSHA safety training, and since I work at ProBrothers, we work under all of the necessary Licenses and Permits. For ProBrothers and I, the client&#x27;s peace of mind is of high importance.|I have worked on many projects, from commercial retirement homes, to a private penthouse in Manhattan. With ProBrothers, I have completed residential basement remodels, cabinet installs, coffered ceilings, custom cigar rooms, and even hidden doors.|It’s hard to choose just one because every project is important to us. We put our heart into every job, no matter the size. Seeing a finished project come together and knowing the homeowner is happy with the result is what makes the work worthwhile.|There are many things that I count as important, but the process itself is what I consider to be at the top of the list. When I arrive at a project, I want to understand every little detail of what I want to do, and have a very clear goal. This prevents silly mistakes. During the task I need to complete, I want to focus on the details and keep a clean workspace to achieve the best outcome. Once everything is finished, I like to do a quick inspection of what I have completed to make sure nothing was missed. Of course, we clean everything up after, to leave the space better than when we arrived.|Outside of work, I enjoy spending time with friends and family, and I love learning new things and growing as a person. My faith, and the community connected to it, is something I also cherish.">
          <div class="team__photo">
            <img src="/assets/img/team/Marsel-Akulov-390x260.webp" alt="Marsel Akulov &mdash; Sales &amp; Carpenter at ProBrothers" loading="lazy" width="390" height="260" />
          </div>
          <div class="team__info">
            <h3>Marsel Akulov</h3>
            <span>Sales &amp; Carpenter</span>
          </div>
        </article>
        <article class="team__card reveal" style="--d:.35s" role="button" tabindex="0" aria-haspopup="dialog"
          data-bio="Once an apprentice, James is now trained carpenter, ready to make your dreams become a reality.|Pro Brothers&#x27; workers are trained to notice the details, work carefully, and bring only the best results to our clients. If you want integrity, honesty, and a hard working working team, you have come to the right place.">
          <div class="team__photo">
            <img src="/assets/img/team/James-390x260.webp" alt="James Akulov &mdash; Carpenter at ProBrothers" loading="lazy" width="390" height="260" />
