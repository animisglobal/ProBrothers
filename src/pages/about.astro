---
import Layout from '../layouts/Layout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://prob.nurotech.co.in/about/",
      "name": "About ProBrothers",
      "url": "https://prob.nurotech.co.in/about/",
      "description": "With over 15 years of experience, ProBrothers has established itself as a leader in the construction industry, known for delivering exceptional quality and craftsmanship.",
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://prob.nurotech.co.in/" },
      "breadcrumb": { "@id": "https://prob.nurotech.co.in/about/#breadcrumb" }
    },
    {
