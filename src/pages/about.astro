      "name": "ProBrothers",
      "url": "https://prob.nurotech.co.in/",
      "logo": "https://prob.nurotech.co.in/assets/img/logo.png",
      "telephone": "+1-484-745-4097",
      "foundingDate": "2010",
      "numberOfEmployees": 7,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "7 Blackhorse Ln",
        "addressLocality": "Media",
        "addressRegion": "PA",
        "postalCode": "19063",
        "addressCountry": "US"
