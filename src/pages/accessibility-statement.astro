---
/**
 * Source URL: https://probrothers.com/accessibility-statement/
 * Copy mode: 2 (with enhancements) — content 100% verbatim from the source page.
 * Errors fixed: the original source obfuscates its contact email as
 *   "info@probrother.com" (singular "brother") — an objective typo. To stay
 *   consistent with the rest of this site (topbar, contact CTA, footer all use
 *   info@probrothers.com) the email here is rendered as info@probrothers.com.
 *   FLAG: confirm with client whether the canonical address is
 *   info@probrothers.com (plural) or info@probrother.com (singular).
 * SEO additions: unique title + meta description (verbatim from source Yoast),
 *   canonical → new route, Open Graph + Twitter Card, WebPage + BreadcrumbList
 *   JSON-LD, breadcrumbs. Reuses the global Topbar/Header/Footer + page-banner
 *   design system established on the homepage/about page.
 */
import Layout from '../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://probrothers.com/accessibility-statement/",
      "name": "Accessibility Statement | ProBrothers",
      "url": "https://probrothers.com/accessibility-statement/",
      "description": "We are dedicated to digital accessibility for all users. We continually improve our website to ensure compliance",
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://probrothers.com/" },
      "breadcrumb": { "@id": "https://probrothers.com/accessibility-statement/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://probrothers.com/accessibility-statement/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://probrothers.com/" },
        { "@type": "ListItem", "position": 2, "name": "Accessibility Statement", "item": "https://probrothers.com/accessibility-statement/" }
      ]
    }
  ]
};
---
<Layout
  title="Accessibility Statement | ProBrothers"
  description="We are dedicated to digital accessibility for all users. We continually improve our website to ensure compliance"
  canonical="https://probrothers.com/accessibility-statement/"
  ogTitle="Accessibility Statement | ProBrothers"
  ogDescription="We are dedicated to digital accessibility for all users. We continually improve our website to ensure compliance"
  ogUrl="https://probrothers.com/accessibility-statement/"
  ogImage="https://probrothers.com/assets/img/hero-remodel.webp"
  twitterTitle="Accessibility Statement | ProBrothers"
  twitterDescription="We are dedicated to digital accessibility for all users. We continually improve our website to ensure compliance"
  twitterImage="https://probrothers.com/assets/img/hero-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Accessibility Statement</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">Accessibility Statement</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Accessible Digital Services for All</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Legal / Statement body ===== -->
  <section class="section legal" aria-label="Accessibility Statement">
    <div class="container container--narrow">
      <article class="legal__body">
        <p><a href="/">Pro Brothers</a> strives to ensure that its digital services are accessible to people with disabilities. Pro Brothers has invested significant resources to help ensure access for all users, including people with disabilities, with the strong belief that every person has the right to live with dignity, equality, comfort and independence.</p>

        <p>Digital accessibility is not just a target we aim to achieve, but an ongoing commitment that we carry in every aspect of our digital service delivery. We recognize that this requires continuous monitoring, improvement, and adaptation. In the sections below, we elaborate on the various efforts that have been undertaken to address our progress in ensuring digital accessibility for all.</p>

        <p>A key element of our accessibility initiative is our engagement with a third-party accessibility consulting organization UserWay to help bring the website into conformance. We use industry standard accessibility methods and tools to accomplish this, in accordance with the relevant version of Web Content Accessibility Guidelines (WCAG) as set forth by the World Wide Web Consortium (W3C) the internet&rsquo;s main international standards-setting organization.</p>

        <p><strong>Please Contact Us</strong><br />We are here to assist you and make your experience as smooth and inclusive as possible. If you encounter any digital accessibility issues with our products or services, or need information related to digital accessibility, we want to hear from you! Also, we appreciate and welcome feedback, and we are always ready to embrace suggestions for enhancing our digital accessibility efforts.</p>

        <p><strong>Contact Information:</strong><br />Pro Brothers<br />Email: <a href="mailto:info@probrothers.com">info@probrothers.com</a><br />We take accessibility seriously and will get back to you shortly.</p>
      </article>

      <p class="legal__credit">Developed by <a href="https://animisglobal.com/" rel="nofollow" target="_blank">Animis Global</a></p>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container--narrow { max-width: 860px; }
  .legal__body {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    border-top: 4px solid var(--accent);
    padding: 2.4rem 2.4rem 2rem;
  }
  .legal__body p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
    margin: 0 0 1.3rem;
  }
  .legal__body p:last-child { margin-bottom: 0; }
  .legal__body a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    transition: color .2s;
  }
  .legal__body a:hover { color: var(--dark); text-decoration: underline; }
  .legal__body strong { color: var(--dark); }
  .legal__credit {
    text-align: center;
    color: var(--muted);
    font-size: .85rem;
    margin: 1.6rem 0 0;
  }
  .legal__credit a { color: var(--accent); text-decoration: none; }
  .legal__credit a:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .legal__body { padding: 1.6rem 1.4rem; }
  }
</style>
