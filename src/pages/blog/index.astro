  ogTitle="Home Remodeling Blog | ProBrothers - PA & Delaware County"
  ogDescription="Expert tips and guides on home remodeling, kitchen cabinets, trim, additions, and construction in Media, PA and the surrounding areas."
  ogUrl="https://probrothers.com/blog/"
  ogImage="https://probrothers.com/assets/img/hero-remodel.webp"
  twitterTitle="Home Remodeling Blog | ProBrothers - PA & Delaware County"
  twitterDescription="Expert tips and guides on home remodeling, kitchen cabinets, trim, additions, and construction in Media, PA."
  twitterImage="https://probrothers.com/assets/img/hero-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Blog</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">Blog</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Home Remodeling Tips, Guides &amp; Insights</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Blog Listing + Sidebar ===== -->
  <section class="section blog-section" id="blog" aria-label="Blog posts">
    <div class="container">
      <div class="blog-layout">

        <!-- ===== Main Posts Feed ===== -->
        <main class="blog-posts" aria-label="Blog post list">
          {posts.slice(0, 10).map((post, i) => (
            <article class={`blog-post reveal${i > 0 ? ` style="--d:${(i * 0.07).toFixed(2)}s"` : ''}`} style={i > 0 ? `--d:${(i * 0.07).toFixed(2)}s` : undefined}>
              <a href={`/blog/${post.slug}/`} class="blog-post__media" tabindex="-1" aria-hidden="true">
                <img
                  src={post.image}
                  alt={post.imageAlt}
                  width={post.imgW}
                  height={post.imgH}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </a>
              <div class="blog-post__body">
                <div class="blog-post__meta">
                  <time datetime={post.dateIso} class="blog-post__date">{post.date}</time>
                  <span class="blog-post__sep" aria-hidden="true">&#124;</span>
                  <ul class="blog-post__cats" aria-label="Categories">
                    {post.categories.map((cat, ci) => (
                      <li><a href={`/blog/?category=${cat.toLowerCase()}`}>{cat}</a>{ci < post.categories.length - 1 && <span aria-hidden="true">,&nbsp;</span>}</li>
                    ))}
                  </ul>
                </div>
                <h2 class="blog-post__title">
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h2>
                <p class="blog-post__excerpt">{post.excerpt}&hellip;</p>
                <a href={`/blog/${post.slug}/`} class="blog-post__readmore">
                  Read More <span aria-hidden="true">&#8594;</span>
                </a>
              </div>
            </article>
          ))}

          <!-- ===== Pagination ===== -->
          <nav class="blog-pagination" aria-label="Blog pagination">
            <span class="blog-pagination__page blog-pagination__page--active" aria-current="page" aria-label="Page 1">1</span>
            <a href="/blog/page/2/" class="blog-pagination__page" aria-label="Page 2">2</a>
            <a href="/blog/page/2/" class="blog-pagination__next" aria-label="Next page">
              Next <span aria-hidden="true">&#8594;</span>
            </a>
          </nav>
        </main>

        <!-- ===== Sidebar ===== -->
        <aside class="blog-sidebar" aria-label="Blog sidebar">

          <!-- Most Viewed Posts -->
          <div class="blog-sidebar__widget reveal">
            <h3 class="blog-sidebar__title">Most Viewed Posts</h3>
            <ul class="blog-sidebar__viewed" role="list">
              {mostViewed.map(mv => (
                <li class="blog-sidebar__viewed-item">
                  <a href={`/blog/${mv.slug}/`}>
                    <span class="blog-sidebar__viewed-title">{mv.title}</span>
                    <span class="blog-sidebar__viewed-count" aria-label={`${mv.views} views`}>{mv.views} views</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          <div class="blog-sidebar__widget reveal" style="--d:.1s">
            <h3 class="blog-sidebar__title">Tags</h3>
            <ul class="blog-sidebar__tags" role="list" aria-label="Post tags">
              {tags.map(tag => (
                <li><a href={`/blog/?tag=${tag.toLowerCase()}`} class="blog-sidebar__tag">{tag}</a></li>
              ))}
            </ul>
          </div>

          <!-- CTA Widget -->
          <div class="blog-sidebar__widget blog-sidebar__cta-widget reveal" style="--d:.2s">
            <h3>Get a FREE Quote!</h3>
            <p>Ready to start your remodeling project? Contact us for a free, no-obligation quote today.</p>
            <a href="/#contact" class="btn btn--accent">Get a Free Quote</a>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
/* ===== Blog Layout ===== */
.blog-section { padding-top: 3rem; }
.blog-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 2.5rem;
  align-items: start;
}

/* ===== Blog Post Card ===== */
.blog-post {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 1.6rem;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: 1.8rem;
  border-left: 4px solid var(--accent);
  transition: box-shadow .35s var(--ease), transform .35s var(--ease);
}
.blog-post:hover { box-shadow: var(--shadow); transform: translateY(-4px); }

.blog-post__media {
  display: block;
  overflow: hidden;
  aspect-ratio: 4/3;
}
.blog-post__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .7s var(--ease);
}
.blog-post:hover .blog-post__media img { transform: scale(1.05); }

.blog-post__body {
  padding: 1.5rem 1.6rem 1.5rem 0;
  display: flex;
  flex-direction: column;
  gap: .7rem;
}

.blog-post__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: .4rem;
  font-size: .82rem;
  color: var(--muted);
}
.blog-post__date { font-weight: 600; }
.blog-post__sep { color: var(--muted); }
.blog-post__cats {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}
.blog-post__cats li { display: flex; align-items: center; }
.blog-post__cats a {
  color: var(--accent);
  font-weight: 700;
  text-decoration: none;
  font-size: .82rem;
  text-transform: uppercase;
  letter-spacing: .03em;
  transition: color .2s;
}
.blog-post__cats a:hover { color: var(--dark); }

.blog-post__title {
  font-size: 1.2rem;
  font-weight: 800;
  line-height: 1.35;
  margin: 0;
}
.blog-post__title a {
  color: var(--dark);
  text-decoration: none;
  transition: color .2s;
}
.blog-post__title a:hover { color: var(--accent); }

.blog-post__excerpt {
  color: var(--muted);
  font-size: .95rem;
  line-height: 1.7;
  margin: 0;
  flex: 1;
}

.blog-post__readmore {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  color: var(--accent);
  font-weight: 800;
  font-size: .88rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  text-decoration: none;
  margin-top: auto;
  transition: gap .25s var(--ease), color .2s;
}
.blog-post__readmore:hover { gap: .6rem; color: var(--dark); }

/* ===== Pagination ===== */
.blog-pagination {
  display: flex;
  align-items: center;
  gap: .5rem;
  margin-top: 1rem;
}
.blog-pagination__page {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius);
  background: #fff;
  box-shadow: var(--shadow-sm);
  color: var(--dark);
  font-weight: 700;
  font-size: .95rem;
  text-decoration: none;
  border: 2px solid transparent;
  transition: background .25s, color .25s, border-color .25s;
}
.blog-pagination__page:hover {
  background: var(--accent);
  color: #fff;
}
.blog-pagination__page--active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.blog-pagination__next {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  margin-left: .5rem;
  color: var(--accent);
  font-weight: 800;
  font-size: .88rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  text-decoration: none;
  transition: gap .25s var(--ease), color .2s;
}
.blog-pagination__next:hover { gap: .6rem; color: var(--dark); }

/* ===== Sidebar ===== */
.blog-sidebar {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 1.6rem;
}

.blog-sidebar__widget {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: 1.6rem;
  border-top: 4px solid var(--accent);
}

.blog-sidebar__title {
  font-size: 1rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--dark);
  margin: 0 0 1.1rem;
  padding-bottom: .7rem;
  border-bottom: 2px solid var(--gray-2, #f5f5f5);
}

.blog-sidebar__viewed {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.blog-sidebar__viewed-item a {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  text-decoration: none;
  transition: color .2s;
}
.blog-sidebar__viewed-item a:hover .blog-sidebar__viewed-title { color: var(--accent); }
.blog-sidebar__viewed-title {
