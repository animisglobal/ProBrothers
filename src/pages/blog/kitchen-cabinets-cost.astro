                    <tr><td>Cabinet materials (custom)</td><td>$500 – $1,200+/linear ft</td></tr>
                    <tr><td>Labor / installation</td><td>$50 – $150/hour</td></tr>
                    <tr><td>Hardware</td><td>$3 – $50+ per piece</td></tr>
