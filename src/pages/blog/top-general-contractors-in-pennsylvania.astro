              <div class="related-card__body">
                <time datetime={post.dateIso} class="related-card__date">{post.date}</time>
                <h3 class="related-card__title"><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
                <a href={`/blog/${post.slug}/`} class="related-card__link">Read More <span aria-hidden="true">&#8594;</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
