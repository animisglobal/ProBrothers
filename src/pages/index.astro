---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <!-- ===== Hero carousel ===== -->
  <section class="hero" id="home">
    <canvas class="hero__particles" id="heroParticles" aria-hidden="true"></canvas>
    <div class="hero__slides">
      <div class="slide is-active">
        <!-- Real <img> so it is the LCP element and is discoverable by the preload scanner -->
        <img class="slide__bg" src="/assets/img/hero-trim.webp"
             srcset="/assets/img/hero-trim-sm.webp 800w, /assets/img/hero-trim.webp 1600w"
             sizes="100vw" alt="" fetchpriority="high" width="1600" height="1034" />
        <div class="container slide__content">
          <span class="slide__eyebrow">Craftsmanship You Can Trust</span>
          <h1 class="slide__title">Precision Trim<br>Work</h1>
          <p class="slide__text">Enhance your home's look with our detailed trim work, adding a touch of sophistication to every room.</p>
          <a href="#services" class="btn btn--accent btn--lg">Explore</a>
        </div>
      </div>
      <div class="slide">
        <img class="slide__bg" src="/assets/img/hero-cabinets.webp"
             srcset="/assets/img/hero-cabinets-sm.webp 800w, /assets/img/hero-cabinets.webp 1600w"
             sizes="100vw" alt="" loading="lazy" width="1600" height="1067" />
        <div class="container slide__content">
          <span class="slide__eyebrow">Built Around Your Space</span>
          <h1 class="slide__title">Custom Cabinets</h1>
          <p class="slide__text">We craft bespoke cabinets that perfectly fit your style and maximize your space.</p>
          <a href="#services" class="btn btn--accent btn--lg">Explore</a>
        </div>
      </div>
      <div class="slide">
        <img class="slide__bg" src="/assets/img/hero-remodel.webp"
             srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
             sizes="100vw" alt="" loading="lazy" width="1600" height="1067" />
        <div class="container slide__content">
          <span class="slide__eyebrow">From Vision to Reality</span>
          <h1 class="slide__title">Full Remodeling Services</h1>
          <p class="slide__text">From start to finish, we handle all aspects of your remodel, turning your vision into reality.</p>
          <a href="#services" class="btn btn--accent btn--lg">Explore</a>
        </div>
      </div>
    </div>

    <button class="hero__arrow hero__arrow--prev" id="prevSlide" aria-label="Previous">&#8249;</button>
    <button class="hero__arrow hero__arrow--next" id="nextSlide" aria-label="Next">&#8250;</button>
    <div class="hero__dots" id="dots"></div>
    <div class="hero__scroll">Scroll <span>&#8595;</span></div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Quote CTA strip ===== -->
  <section class="quote-strip">
    <div class="container quote-strip__inner">
      <h2>Get a Custom Quote</h2>
      <p>Tell us about your project and we'll get back to you within one business day.</p>
      <a href="#contact" class="btn btn--dark btn--lg" data-magnetic>Contact Us</a>
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section class="section services" id="services">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">What We Do</span>
        <h2 class="section__title">Our Services</h2>
        <p class="section__lead">ProBrothers is a full-service residential and commercial construction and remodeling company with <strong>over 15 years of experience</strong>. We bring precision, premium materials, and clear communication to every project.</p>
      </div>

      <div class="cards">
        <article class="card reveal">
          <div class="card__media"><img src="/assets/img/svc-windows.webp" alt="Windows & Doors" loading="lazy" width="750" height="500" /></div>
          <div class="card__body">
            <h3>Windows &amp; Doors</h3>
            <p>Energy-efficient installs and replacements that boost comfort, security, and curb appeal.</p>
            <a href="#contact" class="card__link">Learn more <span>&#8594;</span></a>
          </div>
        </article>
        <article class="card reveal" style="--d:.1s">
          <div class="card__media"><img src="/assets/img/svc-cabinets.webp" alt="Cabinets" loading="lazy" width="750" height="500" /></div>
          <div class="card__body">
            <h3>Cabinets</h3>
            <p>Bespoke cabinetry designed and built to fit your style and maximize every inch of space.</p>
            <a href="#contact" class="card__link">Learn more <span>&#8594;</span></a>
          </div>
        </article>
        <article class="card reveal" style="--d:.2s">
          <div class="card__media"><img src="/assets/img/svc-remodel.webp" alt="Remodeling" loading="lazy" width="750" height="500" /></div>
          <div class="card__body">
            <h3>Remodeling</h3>
            <p>End-to-end remodels managed start to finish, turning your vision into a finished reality.</p>
            <a href="#contact" class="card__link">Learn more <span>&#8594;</span></a>
          </div>
        </article>
      </div>

      <div class="services__cta reveal">
        <a href="#services" class="btn btn--accent">View All Services</a>
      </div>
    </div>
  </section>

  <!-- ===== Recent Projects ===== -->
  <section class="section projects" id="projects">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">Our Work</span>
        <h2 class="section__title">Recent Projects</h2>
      </div>

      <div class="gallery">
        <figure class="tile reveal" data-tilt>
          <img src="/assets/img/proj-office.webp" alt="Dark Blue Office" loading="lazy" width="750" height="500" />
          <figcaption><span>Dark Blue Office</span><em>Trim &amp; Cabinets</em></figcaption>
        </figure>
        <figure class="tile reveal" data-tilt style="--d:.08s">
          <img src="/assets/img/proj-gold.webp" alt="Gold Beams" loading="lazy" width="750" height="500" />
          <figcaption><span>Gold Beams</span><em>Custom Carpentry</em></figcaption>
        </figure>
        <figure class="tile reveal" data-tilt style="--d:.16s">
          <img src="/assets/img/proj-mantle.webp" alt="Gray Mantle & Beams" loading="lazy" width="750" height="500" />
          <figcaption><span>Gray Mantle &amp; Beams</span><em>Trim Work</em></figcaption>
        </figure>
        <figure class="tile reveal" data-tilt style="--d:.24s">
          <img src="/assets/img/proj-window.webp" alt="Large Bathroom Window" loading="lazy" width="750" height="500" />
          <figcaption><span>Large Bathroom Window</span><em>Windows &amp; Doors</em></figcaption>
        </figure>
      </div>

      <!-- Before / After wiper -->
      <div class="ba reveal" data-reveal="zoom">
        <h3 class="ba__title">Drag to See the Transformation</h3>
        <div class="ba__frame" id="baFrame">
          <img class="ba__img ba__img--after" src="/assets/img/proj-mantle.webp" alt="After remodel" draggable="false" width="750" height="500" loading="lazy" />
          <div class="ba__before" id="baBefore">
            <img class="ba__img" src="/assets/img/proj-office.webp" alt="Before remodel" draggable="false" width="750" height="500" loading="lazy" />
          </div>
          <span class="ba__tag ba__tag--before">Before</span>
          <span class="ba__tag ba__tag--after">After</span>
          <div class="ba__handle" id="baHandle" role="slider" aria-label="Reveal before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
            <span class="ba__line"></span>
            <span class="ba__grip">&#8596;</span>
          </div>
        </div>
      </div>

      <div class="services__cta reveal">
        <a href="#projects" class="btn btn--dark">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- ===== Why Choose ===== -->
  <section class="section why" id="about">
    <div class="why__divider" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,45 L1440,0 L0,0 Z"></path></svg>
    </div>
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker section__kicker--light">The ProBrothers Difference</span>
        <h2 class="section__title section__title--light">Why Choose ProBrothers</h2>
      </div>

      <div class="why__grid">
        <div class="why__item reveal">
          <div class="why__num" data-count="15">0</div>
          <h3>Over 15 Years Experience</h3>
          <p>Quality workmanship at competitive pricing, backed by a decade and a half of hands-on expertise.</p>
        </div>
        <div class="why__item reveal" style="--d:.12s">
          <div class="why__ic">&#9874;</div>
          <h3>Best Materials</h3>
          <p>We source premium materials and the right resources for smooth, durable, beautiful results.</p>
        </div>
        <div class="why__item reveal" style="--d:.24s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9.3 8 11 4.5-1.7 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>Professional Standards</h3>
          <p>Planned scheduling and daily communication keep your project on track and stress-free.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Reviews ===== -->
  <section class="section reviews" id="reviews">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">Testimonials</span>
        <h2 class="section__title">Client Reviews</h2>
      </div>

      <div class="cards">
        <blockquote class="review reveal">
          <div class="review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"The craftsmanship was outstanding. Every detail of our remodel was handled with care, and the trim work transformed the whole space."</p>
          <footer>— Sarah &amp; Mike Jenkins</footer>
        </blockquote>
        <blockquote class="review reveal" style="--d:.1s">
          <div class="review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"Communication was excellent from start to finish. They showed up when they said they would and kept me informed every single day."</p>
          <footer>— Dan Miller</footer>
        </blockquote>
        <blockquote class="review reveal" style="--d:.2s">
          <div class="review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"Incredible attention to detail. The custom cabinets fit perfectly and the finish is flawless. Highly recommend ProBrothers."</p>
          <footer>— Andriy Koval</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>
