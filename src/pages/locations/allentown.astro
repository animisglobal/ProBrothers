.loc-intro__body p { max-width: 860px; margin: 0 auto 1rem; font-size: 1.05rem; line-height: 1.8; color: var(--muted); text-align: center; }

.loc-svc {
  display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;
  padding: 3rem 0; border-bottom: 1px solid var(--gray);
}
.loc-svc:last-child { border-bottom: none; }
.loc-svc--flip .loc-svc__media { order: 2; }
.loc-svc--flip .loc-svc__body  { order: 1; }
.loc-svc__media img {
  border-radius: var(--radius); box-shadow: var(--shadow);
  width: 100%; height: 340px; object-fit: cover;
  transition: transform .5s var(--ease);
}
.loc-svc__media:hover img { transform: scale(1.03); }
.loc-svc__body h3 {
  font-size: 1.15rem; font-weight: 900; color: var(--dark);
  margin-bottom: 1rem; line-height: 1.35;
  padding-bottom: .6rem; border-bottom: 3px solid var(--accent);
}
.loc-svc__body p { color: var(--muted); line-height: 1.8; margin-bottom: 1rem; font-size: .97rem; }
.loc-svc__list { list-style: none; display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.2rem; }
.loc-svc__list li { color: var(--muted); font-size: .95rem; line-height: 1.7; padding-left: 1rem; border-left: 3px solid var(--accent); }
.loc-svc__list li strong { color: var(--dark); }
.loc-svc__body .btn { margin-top: .4rem; }

.faq__list { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: .6rem; }
.faq__item { border: 1px solid var(--gray); border-radius: var(--radius); overflow: hidden; }
.faq__q {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: 1.1rem 1.4rem; background: #fff; border: none; cursor: pointer;
  font-size: .97rem; font-weight: 700; color: var(--dark); text-align: left;
  transition: background .2s;
}
.faq__q:hover { background: var(--gray-2); }
.faq__q[aria-expanded="true"] { background: var(--gray-2); }
.faq__chevron { width: 18px; height: 18px; stroke: var(--accent); flex-shrink: 0; transition: transform .3s; }
.faq__q[aria-expanded="true"] .faq__chevron { transform: rotate(180deg); }
.faq__a { padding: 0 1.4rem 1.1rem; background: var(--gray-2); }
.faq__a p { color: var(--muted); line-height: 1.75; font-size: .95rem; margin: 0; }

.contact-form-box__heading { font-size: 1.5rem; font-weight: 900; color: var(--dark); margin-bottom: .5rem; }
.contact-form__privacy { font-size: .8rem; color: var(--muted); margin-top: 1rem; text-align: center; }

@media(max-width:768px){
  .loc-svc { grid-template-columns: 1fr; gap: 1.6rem; }
  .loc-svc--flip .loc-svc__media { order: 0; }
  .loc-svc--flip .loc-svc__body  { order: 0; }
  .loc-svc__media img { height: 240px; }
}
</style>

<script>
(function(){
  document.querySelectorAll('.faq__q').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq__q').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        const a = document.getElementById(b.getAttribute('aria-controls'));
        if (a) a.hidden = true;
      });
      if (!expanded) {
        btn.setAttribute('aria-expanded', 'true');
        const ans = document.getElementById(btn.getAttribute('aria-controls'));
        if (ans) ans.hidden = false;
      }
    });
  });
})();
</script>
