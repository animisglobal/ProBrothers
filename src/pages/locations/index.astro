---
import Layout from '../../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",      "item": "https://probrothers.com/" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://probrothers.com/locations/" }
  ]
};

const locations = [
  { href: '/locations/media/',           name: 'Media, PA',            desc: 'Our home base — full construction and remodeling services in Delaware County.' },
  { href: '/locations/west-chester/',    name: 'West Chester, PA',     desc: 'Custom homes, renovations, and smart-home builds in Chester County.' },
  { href: '/locations/glen-mills/',      name: 'Glen Mills, PA',       desc: 'Premier construction and renovation services in Glen Mills, Pennsylvania.' },
  { href: '/locations/philadelphia/',    name: 'Philadelphia, PA',     desc: 'Historic rowhouse restoration, custom builds & full remodels across Philly.' },
  { href: '/locations/kennett-square/', name: 'Kennett Square, PA',   desc: 'Home construction contractor serving Kennett Square and Chester County.' },
  { href: '/locations/phoenixville/',    name: 'Phoenixville, PA',     desc: 'Top construction company for remodeling & additions in Phoenixville.' },
  { href: '/locations/rehoboth/',        name: 'Rehoboth, DE',         desc: 'General and home construction services in Rehoboth, Delaware.' },
  { href: '/locations/greenville/',      name: 'Greenville, DE',       desc: 'Trusted home remodeler and general contractor in Greenville, Delaware.' },
  { href: '/locations/malvern/',         name: 'Malvern, PA',          desc: 'Residential & commercial construction experts in Malvern, Pennsylvania.' },
  { href: '/locations/springfield/',     name: 'Springfield, PA',      desc: 'Expert construction company serving Springfield and Delaware County.' },
];
---
<Layout
  title="Service Locations | ProBrothers Construction"
  description="ProBrothers serves Media, West Chester, Glen Mills, Philadelphia, Kennett Square, Phoenixville, Rehoboth, Greenville, Malvern, Springfield & surrounding areas."
  canonical="https://probrothers.com/locations/"
  ogTitle="Service Locations | ProBrothers Construction"
  ogDescription="ProBrothers serves 10+ locations across Pennsylvania & Delaware — from Media and West Chester to Rehoboth and Greenville."
  ogUrl="https://probrothers.com/locations/"
  ogImage="https://probrothers.com/assets/img/hero-remodel.webp"
  twitterTitle="Service Locations | ProBrothers Construction"
  twitterDescription="ProBrothers serves Media, West Chester, Glen Mills, Philadelphia & surrounding PA areas."
  twitterImage="https://probrothers.com/assets/img/hero-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1034" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Locations</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">OUR SERVICE LOCATIONS</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Serving Pennsylvania &amp; Delaware with Expert Construction &amp; Remodeling</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Media</span><i>&#9670;</i><span>West Chester</span><i>&#9670;</i><span>Glen Mills</span><i>&#9670;</i>
        <span>Philadelphia</span><i>&#9670;</i><span>Malvern</span><i>&#9670;</i><span>Newtown</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Media</span><i>&#9670;</i><span>West Chester</span><i>&#9670;</i><span>Glen Mills</span><i>&#9670;</i>
        <span>Philadelphia</span><i>&#9670;</i><span>Malvern</span><i>&#9670;</i><span>Newtown</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <section class="section" id="locations" aria-label="Service locations">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">WHERE WE WORK</span>
        <h2 class="section__title">
          Find Your Local ProBrothers Team
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <div class="loc-index-grid">
        {locations.map((loc, i) => (
          <a href={loc.href} class="loc-index-card reveal" style={i > 0 ? `--d:${i * .08}s` : ''}>
            <div class="loc-index-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3>{loc.name}</h3>
            <p>{loc.desc}</p>
            <span class="loc-index-card__cta">View Services <span aria-hidden="true">&#8594;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta" aria-label="Get a free quote">
    <div class="container cta__inner reveal">
      <h2>Serving All of Eastern Pennsylvania &amp; Delaware</h2>
      <p>Don't see your town? Call us — we likely serve your area. Free quotes within one business day.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="/contact/" class="btn btn--ghost btn--lg" data-magnetic>Get a Quote</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.loc-index-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.6rem;
  margin-top: 1rem;
}
.loc-index-card {
  display: flex; flex-direction: column; gap: .6rem;
  background: #fff; border-radius: var(--radius); padding: 2rem 1.6rem;
  box-shadow: var(--shadow-sm); border-top: 4px solid var(--accent);
  text-decoration: none; color: var(--ink);
  transition: transform .35s var(--ease), box-shadow .35s var(--ease);
}
.loc-index-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
.loc-index-card__icon { color: var(--accent); margin-bottom: .2rem; }
.loc-index-card h3 { font-size: 1.15rem; font-weight: 800; color: var(--dark); }
.loc-index-card p { font-size: .93rem; color: var(--muted); line-height: 1.65; flex: 1; }
.loc-index-card__cta { font-size: .82rem; font-weight: 700; color: var(--accent); letter-spacing: .04em; text-transform: uppercase; margin-top: .4rem; }
</style>
