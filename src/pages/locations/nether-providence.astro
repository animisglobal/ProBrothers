.loc-svc__media img {
  border-radius: var(--radius); box-shadow: var(--shadow);
  width: 100%; height: 340px; object-fit: cover;
  transition: transform .5s var(--ease);
}
.loc-svc__media:hover img { transform: scale(1.03); }
