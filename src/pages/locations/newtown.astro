  background: #fff; border-radius: var(--radius); padding: 1rem 1.4rem;
  box-shadow: var(--shadow-sm); border-left: 4px solid var(--accent);
  font-size: .97rem; color: var(--ink); line-height: 1.65;
}
.loc-why__list li strong { display: block; color: var(--dark); }
.loc-why__list li .loc-why__desc { display: block; color: var(--ink); }
.loc-why__cta { text-align: center; }

.loc-svc {
  display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;
  padding: 3rem 0; border-bottom: 1px solid var(--gray);
}
.loc-svc:last-child { border-bottom: none; }
.loc-svc--flip .loc-svc__media { order: 2; }
.loc-svc--flip .loc-svc__body  { order: 1; }
.loc-svc__media img {
  border-radius: var(--radius); box-shadow: var(--shadow);
  width: 100%; height: 340px; object-fit: cover;
  transition: transform .5s var(--ease);
}
.loc-svc__media:hover img { transform: scale(1.03); }
.loc-svc__body h3 {
  font-size: 1.15rem; font-weight: 900; color: var(--dark);
  margin-bottom: 1rem; line-height: 1.35;
  padding-bottom: .6rem; border-bottom: 3px solid var(--accent);
}
.loc-svc__body p { color: var(--muted); line-height: 1.8; margin-bottom: 1rem; font-size: .97rem; }
.loc-svc__body p a { color: var(--accent); }
.loc-svc__body .btn { margin-top: .4rem; }

.loc-cando__body { max-width: 860px; margin: 0 auto; text-align: center; }
.loc-cando__body p { color: var(--muted); line-height: 1.8; font-size: 1rem; margin-bottom: 1.8rem; }
.loc-cando__action { text-align: center; margin-top: 1.6rem; }

.loc-steps {
  display: flex; flex-direction: column; gap: 1rem;
  list-style: none; margin: 0 auto 2rem; max-width: 580px; text-align: left;
}
