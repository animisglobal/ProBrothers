}
.loc-steps__num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2rem; height: 2rem; border-radius: 50%;
  background: var(--accent); color: #fff; font-weight: 900; font-size: .85rem; flex-shrink: 0;
}

.faq__list { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: .6rem; }
.faq__item { border: 1px solid var(--gray); border-radius: var(--radius); overflow: hidden; }
.faq__q {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: 1.1rem 1.4rem; background: #fff; border: none; cursor: pointer;
  font-size: .97rem; font-weight: 700; color: var(--dark); text-align: left;
  transition: background .2s;
}
.faq__q:hover { background: var(--gray-2); }
.faq__q[aria-expanded="true"] { background: var(--gray-2); }
.faq__chevron { width: 18px; height: 18px; stroke: var(--accent); flex-shrink: 0; transition: transform .3s; }
.faq__q[aria-expanded="true"] .faq__chevron { transform: rotate(180deg); }
