---
/**
 * Source URL: https://probrothers.com/our-projects/
 *   + each project's detail page https://probrothers.com/projects/<slug>/
 * Copy mode: 2 (with enhancements) — content 100% VERBATIM from the original site.
 * Errors fixed: none (content untouched).
 * SEO added: CollectionPage + BreadcrumbList JSON-LD, OG/Twitter, canonical, descriptive alts.
 * Enhancement: per-project accessible MODAL/popup (open on card click; close on overlay / X / Esc)
 *   showing that project's verbatim title + description and its full image gallery laid out beside
 *   the copy. Replaces the old out-links to probrothers.com detail pages. Project data (verbatim
 *   title, paragraphs, images, alt text) lives in src/data/projects.ts. Images inside a modal still
 *   open in the existing global lightbox for full-screen viewing.
 */
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://probrothers.com/projects/",
      "name": "Our Projects",
      "description": "Discover ProBrothers' construction, remodeling, cabinetry, and trim projects across Pennsylvania and Delaware.",
      "url": "https://probrothers.com/projects/"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://probrothers.com/projects/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://probrothers.com/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://probrothers.com/projects/" }
      ]
    }
  ]
};
---
<Layout
  title="Our Projects — Remodeling, Cabinetry & Trim | ProBrothers"
  description="Explore ProBrothers' portfolio of trim, cabinets, remodeling, and windows & doors projects across Media, PA and the Southeastern Philadelphia area."
  canonical="https://probrothers.com/projects/"
  ogTitle="Our Projects | ProBrothers — Trim, Cabinets, Remodeling, Windows & Doors"
  ogDescription="A portfolio of expertly crafted trim, stunning custom cabinets, comprehensive remodels, and professional window & door installations."
  ogUrl="https://probrothers.com/projects/"
  ogImage="https://probrothers.com/assets/img/proj-office.webp"
  twitterTitle="Our Projects | ProBrothers"
  twitterDescription="A portfolio of expertly crafted trim, custom cabinets, remodels, and window & door installations by ProBrothers."
  twitterImage="https://probrothers.com/assets/img/proj-office.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="Completed remodeling and construction projects by ProBrothers in Delaware County, PA" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Our Projects</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">OUR PROJECTS</h1>
      <p class="page-banner__sub">ProBrothers &mdash; A Portfolio of Craftsmanship Across Media, PA</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Project Categories ===== -->
  <section class="section proj-section" id="project-categories" aria-label="Project Categories">
    <div class="container">
      <div class="proj-section__head reveal">
        <h2 class="proj-section__title">Project Categories</h2>
      </div>

      <div class="proj-cats">
        <a class="proj-cat reveal" href="/projects/trim/">
          <img src="/assets/img/proj-gold.webp" alt="Expertly crafted trim work" loading="lazy" width="800" height="1000" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">TRIM</span>
            <h3 class="proj-cat__title">Expertly Crafted Trim Work</h3>
            <span class="proj-cat__cta">View Projects <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
        <a class="proj-cat reveal" style="--d:.08s" href="/projects/cabinets/">
          <img src="/assets/img/proj-office.webp" alt="Stunning custom cabinets" loading="lazy" width="800" height="1000" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">CABINETS</span>
            <h3 class="proj-cat__title">Stunning Custom Cabinets</h3>
            <span class="proj-cat__cta">View Projects <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
        <a class="proj-cat reveal" style="--d:.16s" href="/projects/remodeling/">
          <img src="/assets/img/proj-mantle.webp" alt="Comprehensive remodeling expertise" loading="lazy" width="800" height="1000" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">REMODELING</span>
            <h3 class="proj-cat__title">Comprehensive Remodeling Expertise</h3>
            <span class="proj-cat__cta">View Projects <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
        <a class="proj-cat reveal" style="--d:.24s" href="/projects/windows-doors/">
          <img src="/assets/img/proj-window.webp" alt="Professional windows and doors" loading="lazy" width="800" height="1000" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">WINDOWS &amp; DOORS</span>
            <h3 class="proj-cat__title">Professional Windows &amp; Doors</h3>
            <span class="proj-cat__cta">View Projects <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== All Projects List ===== -->
  <section class="section proj-section" id="all-projects" style="background:var(--gray-2)" aria-label="All Projects">
    <div class="container">
      <div class="proj-section__head reveal" style="padding-top:2.5rem">
        <h2 class="proj-section__title">All Projects</h2>
      </div>
      <ul class="proj-grid">
        {projects.map((p, i) => (
          <li class="reveal" style={`--d:${(i % 4) * 0.07}s`}>
            <button
              type="button"
              class="proj-card"
              data-project-index={i}
              aria-haspopup="dialog"
              aria-controls="projectModal"
              aria-label={`View project details: ${p.name}`}
            >
              <div class="proj-card__thumb">
                <img src={p.thumb} alt={p.name} loading="lazy" width="768" height="1024" />
                <div class="proj-card__overlay" aria-hidden="true"></div>
              </div>
              <div class="proj-card__body">
                <p class="proj-card__name">{p.name}</p>
                <span class="proj-card__cta">
                  View Project
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h12M7 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Featured Case Studies ===== -->
  <section class="section proj-section" id="case-studies" aria-label="Featured Case Studies">
    <div class="container">
      <div class="proj-section__head reveal">
        <h2 class="proj-section__title">Featured Case Studies</h2>
        <p class="proj-section__sub">Full project stories — scope, crew, process, photos, and client results.</p>
      </div>
      <div class="proj-cats">
        <a class="proj-cat reveal" href="/projects/family-room-wall-panels-newtown-square/">
          <img src="/assets/img/projects/case-studies/family_IMG_5910.webp" alt="Custom wall panels and cabinet installation — Newtown Square, PA family room by ProBrothers" loading="lazy" width="900" height="1200" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">CASE STUDY — TRIM &amp; CABINETS</span>
            <h3 class="proj-cat__title">Custom Wall Panels &amp; Cabinet Renovation — Newtown Square, PA</h3>
            <p style="font-size:0.85rem;margin:0.25rem 0 0.5rem;opacity:0.85">2 weeks &nbsp;·&nbsp; $22,000 &nbsp;·&nbsp; Crew: Marsel, Vitaly, Alex</p>
            <span class="proj-cat__cta">Read Case Study <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
        <a class="proj-cat reveal" style="--d:.08s" href="/projects/kitchen-range-tile-west-chester/">
          <img src="/assets/img/projects/case-studies/kitchen_IMG_6872.webp" alt="Kitchen range hood and tile installation — West Chester, PA by ProBrothers Construction" loading="lazy" width="900" height="1200" />
          <div class="proj-cat__body">
            <span class="proj-cat__kicker">CASE STUDY — KITCHEN</span>
            <h3 class="proj-cat__title">Kitchen Range Hood &amp; Tile Installation — West Chester, PA</h3>
            <p style="font-size:0.85rem;margin:0.25rem 0 0.5rem;opacity:0.85">3 days &nbsp;·&nbsp; $10,000 &nbsp;·&nbsp; Crew: Marsel, James, Alex</p>
            <span class="proj-cat__cta">Read Case Study <span aria-hidden="true">&#8594;</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Project detail data (verbatim) for the modal ===== -->
  <script type="application/json" id="projectData" is:inline set:html={JSON.stringify(projects)} />

  <!-- ===== Project Modal / Popup ===== -->
  <div class="proj-modal" id="projectModal" role="dialog" aria-modal="true" aria-labelledby="projModalTitle" hidden>
    <div class="proj-modal__overlay" data-proj-close></div>
    <div class="proj-modal__dialog" role="document">
      <button type="button" class="proj-modal__close" data-proj-close aria-label="Close project details">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="proj-modal__scroll">
        <header class="proj-modal__head">
          <span class="proj-modal__kicker">ProBrothers Project</span>
          <h2 class="proj-modal__title" id="projModalTitle"></h2>
        </header>
        <div class="proj-modal__body">
          <div class="proj-modal__copy" id="projModalCopy"></div>
          <div class="proj-carousel" id="projModalCarousel" aria-roledescription="carousel" aria-label="Project images">
            <div class="proj-carousel__viewport">
              <div class="proj-carousel__track" id="projCarouselTrack"></div>
              <button type="button" class="proj-carousel__nav proj-carousel__prev" id="projCarouselPrev" aria-label="Previous image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button type="button" class="proj-carousel__nav proj-carousel__next" id="projCarouselNext" aria-label="Next image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
              <span class="proj-carousel__counter" id="projCarouselCounter" aria-live="polite"></span>
            </div>
            <div class="proj-carousel__dots" id="projCarouselDots" role="tablist" aria-label="Choose image"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<script>
/* ---------- Project detail popup (Projects page) ----------
   Opens on card click, populates verbatim title/description/images from #projectData,
   closes on overlay click / X / Esc. Images inside reuse .gallery__item + data-gallery
   so the global lightbox (public/script.js) still opens them full-screen. */
(function projectPopup() {
  const modal = document.getElementById('projectModal');
  const dataEl = document.getElementById('projectData');
  if (!modal || !dataEl) return;

  let projects = [];
  try { projects = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }

  const titleEl = modal.querySelector('#projModalTitle');
  const copyEl = modal.querySelector('#projModalCopy');
  const dialog = modal.querySelector('.proj-modal__dialog');
  const carousel = modal.querySelector('#projModalCarousel');
  const track = modal.querySelector('#projCarouselTrack');
  const counterEl = modal.querySelector('#projCarouselCounter');
  const dotsEl = modal.querySelector('#projCarouselDots');
  const prevBtn = modal.querySelector('#projCarouselPrev');
  const nextBtn = modal.querySelector('#projCarouselNext');
  const closeEls = modal.querySelectorAll('[data-proj-close]');
  const cards = document.querySelectorAll('.proj-card[data-project-index]');
  let lastFocused = null;

  // ----- carousel state -----
  let slideCount = 0;
  let curIndex = 0;

  function goTo(i) {
    if (slideCount === 0) return;
    if (i < 0) i = slideCount - 1;
    if (i >= slideCount) i = 0;
    curIndex = i;
    track.style.transform = 'translateX(' + (-curIndex * 100) + '%)';
    counterEl.textContent = (curIndex + 1) + ' / ' + slideCount;
    Array.prototype.forEach.call(dotsEl.children, function (dot, d) {
      const active = d === curIndex;
      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
      dot.tabIndex = active ? 0 : -1;
    });
    // Slides outside view shouldn't be focus/tab targets.
    Array.prototype.forEach.call(track.children, function (slide, s) {
      const item = slide.querySelector('.gallery__item');
      if (item) item.tabIndex = s === curIndex ? 0 : -1;
    });
  }

  function render(p) {
    titleEl.textContent = p.title || p.name || '';

    // Verbatim description paragraphs (may be empty for image-only projects)
    copyEl.innerHTML = '';
    const hasCopy = !!(p.description && p.description.length);
    if (hasCopy) {
      const lead = document.createElement('h3');
      lead.className = 'proj-modal__subtitle';
      lead.textContent = 'About This Project';
      copyEl.appendChild(lead);
      p.description.forEach(function (para) {
        const text = (para || '').trim();
        if (!text) return;
        const el = document.createElement('p');
        el.textContent = text;
        copyEl.appendChild(el);
      });
      copyEl.hidden = false;
    } else {
      // No descriptive copy on the original page — show the carousel only.
      copyEl.hidden = true;
    }

    // Carousel — one slide per image. Each image is still a .gallery__item button so the
    // global lightbox (public/script.js) opens it full-screen with prev/next/counter/caption.
    track.innerHTML = '';
    dotsEl.innerHTML = '';
    const imgs = p.images || [];
    slideCount = imgs.length;
    const groupId = 'projmodal-' + (p.slug || 'project');

    imgs.forEach(function (img, i) {
      const slide = document.createElement('div');
      slide.className = 'proj-carousel__slide';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'gallery__item';
      btn.setAttribute('data-gallery', groupId);
      btn.setAttribute('data-full', img.src);
      btn.setAttribute('data-caption', img.alt || '');
      btn.setAttribute('aria-label', 'Enlarge image: ' + (img.alt || p.name));
      const im = document.createElement('img');
      im.src = img.src;
      im.alt = img.alt || p.name;
      im.loading = i === 0 ? 'eager' : 'lazy';
      im.width = 768;
      im.height = 1024;
      btn.appendChild(im);
      const zoom = document.createElement('span');
      zoom.className = 'gallery__zoom';
      zoom.setAttribute('aria-hidden', 'true');
      zoom.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>';
      btn.appendChild(zoom);
      slide.appendChild(btn);
      track.appendChild(slide);

      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'proj-carousel__dot';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', 'Go to image ' + (i + 1));
      dot.addEventListener('click', function () { goTo(i); });
      dotsEl.appendChild(dot);
    });

    // Hide arrows/dots/counter when there is only one image.
    const multi = slideCount > 1;
    carousel.classList.toggle('proj-carousel--single', !multi);

    // Layout flags: solo image gets a centred frame; image-only projects drop the text column.
    dialog.classList.toggle('proj-modal__dialog--solo', slideCount === 1);
    dialog.classList.toggle('proj-modal__dialog--nocopy', !hasCopy);

    // Reset to first slide (transition-free so it doesn't animate on open).
    track.style.transition = 'none';
    goTo(0);
    // Re-enable the slide transition on the next frame.
    requestAnimationFrame(function () { track.style.transition = ''; });
  }

  prevBtn.addEventListener('click', function () { goTo(curIndex - 1); });
  nextBtn.addEventListener('click', function () { goTo(curIndex + 1); });

  // Swipe support on the carousel viewport (ignored while the lightbox is open).
  let touchX = null;
  const viewport = modal.querySelector('.proj-carousel__viewport');
  viewport.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
  viewport.addEventListener('touchend', function (e) {
    if (touchX === null || slideCount < 2 || document.querySelector('.lightbox.open')) { touchX = null; return; }
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 45) goTo(curIndex + (dx < 0 ? 1 : -1));
    touchX = null;
  });

  function open(card) {
    const idx = parseInt(card.getAttribute('data-project-index'), 10);
    const p = projects[idx];
    if (!p) return;
    lastFocused = card;
    render(p);
    modal.hidden = false;
    requestAnimationFrame(function () { modal.classList.add('open'); });
    document.body.classList.add('modal-open');
    modal.querySelector('.proj-modal__scroll').scrollTop = 0;
    modal.querySelector('.proj-modal__close').focus();
  }

  function close() {
    modal.classList.remove('open');
    document.body.classList.remove('modal-open');
    setTimeout(function () { modal.hidden = true; }, 300);
    if (lastFocused) lastFocused.focus();
  }

  cards.forEach(function (card) {
    card.addEventListener('click', function () { open(card); });
  });
  closeEls.forEach(function (el) { el.addEventListener('click', close); });

  document.addEventListener('keydown', function (e) {
    if (!modal.classList.contains('open')) return;
    // If the full-screen lightbox is open over the modal, let it handle keys first.
    if (document.querySelector('.lightbox.open')) return;
    if (e.key === 'Escape') { close(); return; }
    if (slideCount > 1 && e.key === 'ArrowLeft') { goTo(curIndex - 1); }
    if (slideCount > 1 && e.key === 'ArrowRight') { goTo(curIndex + 1); }
  });

  // Basic focus trap within the dialog.
  modal.addEventListener('keydown', function (e) {
    if (e.key !== 'Tab' || !modal.classList.contains('open')) return;
    const focusables = dialog.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
})();
</script>
