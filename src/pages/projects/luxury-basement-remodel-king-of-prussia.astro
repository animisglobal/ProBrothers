                    <tr><td>Service</td><td>Full Luxury Basement Remodel — Bar, Cigar Room, Wine Display, Full Bathroom, Custom Cabinetry &amp; Millwork</td></tr>
                    <tr><td>Budget</td><td>$100,000</td></tr>
                    <tr><td>Timeline</td><td>2 months</td></tr>
                    <tr><td>Crew</td><td>Daniel, James, Marsel, Vitaly, Alex</td></tr>
                  </tbody>
                </table>
              </div>
