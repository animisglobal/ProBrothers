---
/**
 * Source URL: https://probrothers.com/remodeling/
 * Verbatim "About This Project" text preserved.
 */
import Layout from '../../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://prob.nurotech.co.in/projects/remodeling/",
      "name": "Remodeling Projects",
      "description": "ProBrothers' remodeling portfolio featuring Blackhorse House — a full interior and exterior remodel in Media, PA.",
      "url": "https://prob.nurotech.co.in/projects/remodeling/"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://prob.nurotech.co.in/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://prob.nurotech.co.in/projects/" },
        { "@type": "ListItem", "position": 3, "name": "Remodeling", "item": "https://prob.nurotech.co.in/projects/remodeling/" }
      ]
    }
  ]
};

const projects = [
  {
    id: 'blackhorse-house',
    title: 'Blackhorse House',
    body: "This was a remodeling project that we had in Media Pa. The house had a garage, a sunroom that was used as a salon, living area, and an unfinished basement. Starting with the interior, everything was demolished, from old flooring, to drywall. Two walls were removed to create a more open plan, with the kitchen doubling in size, and connecting with the living room. The basement went from being an unlivable concrete room, to an amazing relax area with a bedroom and full bathroom. Everything was then repainted, retiled, and new flooring was installed. The Exterior got massive upgrades too. The side entrance door was moved to the center with new windows on the sides. A new concrete walkway was poured, with floating shelves and lights. We then reroofed the roof, installed board and batten on the gables, and a porch was built in the backyard. We started with a beat up house that no one would want to go near, to an incredible finished product, with a simple, modern, and very attractive look.",
    images: [
      { src: '/assets/img/projects/Remodeling-BlackHorse-House-1024x768.webp', alt: 'Expert remodeling services for beautiful home transformations' }
    ]
  }
];
---
<Layout
  title="Remodeling Projects | Our Latest 2026 Renovation Projects"
  description="See ProBrothers' latest remodeling project — Blackhorse House in Media, PA — a full interior and exterior renovation showcasing our craftsmanship."
  canonical="https://prob.nurotech.co.in/projects/remodeling/"
  ogTitle="Remodeling Projects | Our Latest 2026 Renovation Projects"
  ogDescription="Blackhorse House: a complete interior and exterior remodel in Media, PA by ProBrothers."
  ogUrl="https://prob.nurotech.co.in/projects/remodeling/"
  ogImage="https://prob.nurotech.co.in/assets/img/svc-remodel.webp"
  twitterTitle="Remodeling Projects | Latest Renovations"
  twitterDescription="Blackhorse House — a full remodel by ProBrothers in Media, PA."
  twitterImage="https://prob.nurotech.co.in/assets/img/svc-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects/">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Remodeling</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">REMODELING</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Remodeling Projects in Media, PA &amp; Beyond</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  {projects.map((p, i) => (
    <section class="section proj-section" id={p.id} aria-labelledby={`${p.id}-heading`} style={i % 2 === 1 ? 'background:var(--gray-2)' : ''}>
      <div class="container">
        <div class="proj-section__head reveal">
          <span class="proj-section__sub">PROJECT {String(i + 1).padStart(2, '0')}</span>
          <h2 class="proj-section__title" id={`${p.id}-heading`}>{p.title}</h2>
        </div>
        {p.body && (
          <div class="proj-section__about reveal">
            <h3>About This Project</h3>
            <p>{p.body}</p>
          </div>
        )}
        <div class="gallery reveal">
          {p.images.map(img => (
            <button type="button" class="gallery__item" data-gallery={p.id} data-full={img.src} data-caption={img.alt} aria-label={`Enlarge image: ${img.alt}`}>
              <img src={img.src} alt={img.alt} loading="lazy" width="800" height="600" />
              <span class="gallery__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </span>
              <span class="gallery__cap">{img.alt}</span>
            </button>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>
