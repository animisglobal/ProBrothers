---
/**
 * Source URL: https://probrothers.com/windows-doors/
 * Image-focused portfolio page (source has no descriptive paragraphs).
 */
import Layout from '../../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://probrothers.com/projects/windows-doors/",
      "name": "Windows & Doors Projects",
      "description": "ProBrothers' window and door installation portfolio — new doors, black windows, large bathroom windows and window casing projects.",
      "url": "https://probrothers.com/projects/windows-doors/"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://probrothers.com/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://probrothers.com/projects/" },
        { "@type": "ListItem", "position": 3, "name": "Windows & Doors", "item": "https://probrothers.com/projects/windows-doors/" }
      ]
    }
  ]
};

const projects = [
  {
    id: 'doors',
    title: 'Doors',
    body: '',
    images: [
      { src: '/assets/img/projects/New-Door-and-Trim-768x1024.webp', alt: 'New Door and Trim' },
      { src: '/assets/img/projects/White-Door-and-Trim-768x1024.webp', alt: 'White Door and Trim' },
      { src: '/assets/img/projects/New-Windows-and-Slide-door-768x1024.webp', alt: 'New Windows and Slide door' },
      { src: '/assets/img/projects/New-Window-Blue-Shutter-768x1024.webp', alt: 'New Window, Blue Shutter' },
      { src: '/assets/img/projects/New-Sliding-Door-768x1024.webp', alt: 'New Sliding Door' }
    ]
  },
  {
    id: 'black-window',
    title: 'Black Window',
    body: '',
    images: [
      { src: '/assets/img/projects/Black-Windows-1-1024x768.webp', alt: 'Black Windows 1' },
      { src: '/assets/img/projects/Black-Windows-3-576x1024.webp', alt: 'Black Windows 3' },
      { src: '/assets/img/projects/Black-Windows-2-1024x768.webp', alt: 'Black Windows 2' },
      { src: '/assets/img/projects/Black-Windows-1024x768.webp', alt: 'Black Windows' }
    ]
  },
  {
    id: 'large-bathroom-window',
    title: 'Large Bathroom Window',
    body: '',
    images: [
      { src: '/assets/img/projects/Large-Bathroom-Window-1024x768.webp', alt: 'Large Bathroom Window' }
    ]
  },
  {
    id: 'window-casing',
    title: 'Window Casing',
    body: '',
    images: [
      { src: '/assets/img/projects/Window-Casing-1-641x1024.webp', alt: 'Window Casing 1' },
      { src: '/assets/img/projects/Window-Casing-866x1024.webp', alt: 'Window Casing' }
    ]
  }
];
---
<Layout
  title="Window and Door Installation Projects | ProBrothers"
  description="See ProBrothers' window and door installation portfolio — new doors, black windows, large bathroom windows and custom window casing across Pennsylvania."
  canonical="https://probrothers.com/projects/windows-doors/"
  ogTitle="Window and Door Installation Projects | ProBrothers"
  ogDescription="A portfolio of window and door installations — new doors, black windows, bathroom windows and window casing."
  ogUrl="https://probrothers.com/projects/windows-doors/"
  ogImage="https://probrothers.com/assets/img/proj-window.webp"
  twitterTitle="Window & Door Installation Projects | ProBrothers"
  twitterDescription="ProBrothers' latest window and door installations and casing work."
  twitterImage="https://probrothers.com/assets/img/proj-window.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/svc-windows.webp"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/svc-windows.webp"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1067" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects/">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Windows &amp; Doors</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">WINDOWS &amp; DOORS</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Window &amp; Door Installation Projects in Media, PA</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  {projects.map((p, i) => (
    <section class="section proj-section" id={p.id} aria-labelledby={`${p.id}-heading`} style={i % 2 === 1 ? 'background:var(--gray-2)' : ''}>
      <div class="container">
        <div class="proj-section__head reveal">
          <span class="proj-section__sub">PROJECT {String(i + 1).padStart(2, '0')}</span>
          <h2 class="proj-section__title" id={`${p.id}-heading`}>{p.title}</h2>
        </div>
        <div class="gallery reveal">
          {p.images.map(img => (
            <button type="button" class="gallery__item" data-gallery={p.id} data-full={img.src} data-caption={img.alt} aria-label={`Enlarge image: ${img.alt}`}>
              <img src={img.src} alt={img.alt} loading="lazy" width="800" height="600" />
              <span class="gallery__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </span>
              <span class="gallery__cap">{img.alt}</span>
            </button>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ===== More Project Categories (internal links — crawl/discovery) ===== -->
  <section class="section proj-xlinks" aria-label="More project categories">
    <div class="container">
      <h2 class="proj-section__title" style="margin-bottom:1.4rem">Explore More Project Categories</h2>
      <div class="proj-xlinks__row">
        <a class="proj-xlink" href="/projects/trim/">Trim Projects <span aria-hidden="true">&#8594;</span></a><a class="proj-xlink" href="/projects/cabinets/">Cabinets Projects <span aria-hidden="true">&#8594;</span></a><a class="proj-xlink" href="/projects/remodeling/">Remodeling Projects <span aria-hidden="true">&#8594;</span></a>
      </div>
      <p class="proj-xlinks__svc">Looking for the service? See our <a href="/services/windows-and-doors/">Windows & Doors services</a> and <a href="/projects/">all projects</a>.</p>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>
