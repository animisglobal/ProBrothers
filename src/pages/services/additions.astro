---
/**
 * Source URL: https://probrothers.com/services/additions/
 */

import Layout from '../../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://prob.nurotech.co.in/services/additions/",
      "name": "Custom Home Additions",
      "description": "Custom home additions in Media, PA — room additions, garage additions, second-story additions and sunrooms designed and built by ProBrothers.",
      "provider": {
        "@type": "GeneralContractor",
        "name": "ProBrothers",
        "url": "https://prob.nurotech.co.in/",
        "telephone": "+1-484-745-4097",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7 Blackhorse Ln",
          "addressLocality": "Media",
          "addressRegion": "PA",
          "postalCode": "19063",
          "addressCountry": "US"
        }
      },
      "areaServed": ["Media", "West Chester", "Philadelphia", "Newtown Square", "Allentown"],
      "url": "https://prob.nurotech.co.in/services/additions/"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://prob.nurotech.co.in/services/additions/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://prob.nurotech.co.in/" },
        { "@type": "ListItem", "position": 2, "name": "Additions", "item": "https://prob.nurotech.co.in/services/additions/" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://prob.nurotech.co.in/services/additions/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What types of additions does ProBrothers offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ProBrothers specializes in professional, custom-built additions tailored to transform your home's potential. With service like: room additions, garage additions, or second-story additions), We focus on delivering high-quality, functional spaces that meet both residential and commercial needs."
          }
        },
        {
          "@type": "Question",
          "name": "Will ProBrothers handle permits and regulations for additions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We take the hassle out of the permitting process. ProBrothers manages all necessary permits and ensures your addition complies with local building codes and regulations. Our experience allows us to navigate these requirements smoothly, so you can focus on enjoying your new space."
          }
        },
        {
          "@type": "Question",
          "name": "What sets ProBrothers apart from other addition contractors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ProBrothers stands out with over 15 years of experience, a dedication to personalized service, and a proven track record of quality craftsmanship. Unlike other contractors, we manage every aspect of your project—design, materials, and installation, ensuring a cohesive and stress-free process. Our focus on customer satisfaction makes us a top choice for home additions in Pennsylvania."
          }
        },
        {
          "@type": "Question",
          "name": "What is the typical timeline for a home addition project with ProBrothers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Home addition is an extensive task and requires a lot of attention to detail. The timeline for a home addition depends on the project's size and complexity. At ProBrothers, we prioritize efficiency without compromising quality. After an initial consultation, we provide a detailed schedule and maintain daily communication to keep your project on track."
          }
        }
      ]
    }
  ]
};
---
<Layout
  title="Custom Home Additions Contractor in Media, PA | ProBrothers"
  description="Custom home additions in Media, PA — room additions, second-story additions, sunrooms & garage additions. Free quote from ProBrothers."
  canonical="https://prob.nurotech.co.in/services/additions/"
  ogTitle="Custom Home Additions Contractor in Media, PA | ProBrothers"
  ogDescription="ProBrothers builds custom home additions — room, garage and second-story additions — in Media, PA. Free quote."
  ogUrl="https://prob.nurotech.co.in/services/additions/"
  ogImage="https://prob.nurotech.co.in/assets/img/hero-remodel.webp"
  twitterTitle="Custom Home Additions in Media, PA"
  twitterDescription="Custom-built home additions in Media, PA. Free quote from ProBrothers."
  twitterImage="https://prob.nurotech.co.in/assets/img/hero-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         srcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
         sizes="100vw" alt="" fetchpriority="high" width="1600" height="1034" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Additions</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">ADDITIONS</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Custom Home Additions Contractor in Media, PA</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Service Overview ===== -->
  <section class="section svc-overview" id="service-overview" aria-label="Service Overview">
    <div class="container">
      <div class="svc-overview__grid">
        <div class="svc-overview__content reveal" data-reveal="left">
          <span class="section__kicker">SERVICE OVERVIEW</span>
          <h2 class="section__title">
            Custom Home Additions
            <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
              <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
              <circle cx="8" cy="12" r="3" style="--len:20"/>
              <circle cx="152" cy="13" r="3" style="--len:20"/>
            </svg>
          </h2>
          <p class="svc-overview__para">Home additions are the perfect solution in 2026 and beyond for homeowners looking to renovate or expand and enhance their living space without the need to relocate. Whether you're dreaming of a larger kitchen, a new master suite, a sunroom, or second story addition, a custom home addition allows you to create more room tailored to your needs. Custom home additions can take many forms, including expanding outward with new room additions, building upward with an additional story, or even converting underutilized spaces like basements or attics into functional living areas. These enhancements not only provide you with the extra space you need but also increase your home's value and functionality.</p>
          <p class="svc-overview__para">As one of the best home addition contractors of Media, Pennsylvania, we specialize in designing and building custom home additions that seamlessly integrate with your existing structure. With over 15 years of experience, our team of custom home builders has the expertise to handle every aspect of your project, from initial home addition designs to final construction. We understand that a custom home addition is a significant investment, which is why we take a meticulous approach to ensure every detail is executed with precision and care. Our commitment to quality craftsmanship and personalized home improvement solutions sets us apart, making us the trusted choice for homeowners who want to expand their living space or even want a seond story addition. When you choose ProBrothers, you're not just adding space&mdash;you're enhancing your home with the care and expertise that only our team can provide.</p>
          <a href="/contact/" class="btn btn--accent btn--lg" data-magnetic>Request a Quote</a>
        </div>
        <div class="svc-overview__media reveal" data-reveal="right">
          <figure class="svc-overview__figure">
            <img src="/assets/img/svc-remodel.webp"
                 alt="Spacious home additions for enhanced living areas"
                 loading="lazy" width="768" height="1024" />
            <figcaption>Spacious Additions</figcaption>
          </figure>
          <figure class="svc-overview__figure">
            <img src="/assets/img/proj-window.webp"
                 alt="Brand new doors and window installation for home addition"
                 loading="lazy" width="768" height="1024" />
            <figcaption>New Construction</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Client Testimonial ===== -->
  <section class="section svc-testimonial-only" id="addition-testimonial" aria-label="Client Testimonial">
    <div class="container">
      <blockquote class="svc-testimonial svc-testimonial--center reveal">
        <div class="review__stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p>&ldquo;The sunroom addition they built for us is now our favorite room in the house. Great quality build and excellent insulation.&rdquo;</p>
        <footer>Carlos Ramirez</footer>
      </blockquote>
    </div>
  </section>

  <!-- ===== Why Choose Us Stats ===== -->
  <section class="section why why-about" id="why-choose-us" aria-label="Why Choose ProBrothers">
    <div class="why__divider" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
        <path d="M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,45 L1440,0 L0,0 Z" />
      </svg>
    </div>
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker section__kicker--light">The ProBrothers Difference</span>
        <h2 class="section__title section__title--light">WHY CHOOSE US</h2>
      </div>
      <div class="why__grid">
        <div class="why__item reveal">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="why__num" data-count="15">0</div>
          <h3>Years of Professional Experience</h3>
        </div>
        <div class="why__item reveal" style="--d:.12s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="why__num" data-count="135">0</div>
          <h3>Completed Projects and Investments</h3>
        </div>
        <div class="why__item reveal" style="--d:.24s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="why__num" data-count="12">0</div>
          <h3>Skilled Professionals</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section svc-faq" id="faq" aria-label="Frequently Asked Questions">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">HAVE QUESTIONS?</span>
        <h2 class="section__title">
          FREQUENTLY ASKED QUESTIONS
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <dl class="faq-list">
        <div class="faq-item reveal">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What types of additions does ProBrothers offer?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a">
            <p>ProBrothers specializes in professional, custom-built additions tailored to transform your home's potential. With service like: room additions, garage additions, or second-story additions), We focus on delivering high-quality, functional spaces that meet both residential and commercial needs.</p>
          </dd>
        </div>
        <div class="faq-item reveal" style="--d:.07s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              Will ProBrothers handle permits and regulations for additions?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a">
            <p>We take the hassle out of the permitting process. ProBrothers manages all necessary permits and ensures your addition complies with local building codes and regulations. Our experience allows us to navigate these requirements smoothly, so you can focus on enjoying your new space.</p>
          </dd>
        </div>
        <div class="faq-item reveal" style="--d:.14s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What sets ProBrothers apart from other addition contractors?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a">
            <p>ProBrothers stands out with over 15 years of experience, a dedication to personalized service, and a proven track record of quality craftsmanship. Unlike other contractors, we manage every aspect of your project&mdash;design, materials, and installation, ensuring a cohesive and stress-free process. Our focus on customer satisfaction makes us a top choice for home additions in Pennsylvania.</p>
          </dd>
        </div>
        <div class="faq-item reveal" style="--d:.21s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What is the typical timeline for a home addition project with ProBrothers?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a">
            <p>Home addition is an extensive task and requires a lot of attention to detail. The timeline for a home addition depends on the project's size and complexity. At ProBrothers, we prioritize efficiency without compromising quality. After an initial consultation, we provide a detailed schedule and maintain daily communication to keep your project on track.</p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===== Related Services ===== -->
  <section class="section" id="related-services" style="background:var(--gray-2)" aria-label="Related Services">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">EXPLORE MORE</span>
        <h2 class="section__title">
          RELATED SERVICES
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <div class="cards">
        <article class="card reveal">
          <div class="card__media">
            <img src="/assets/img/svc-remodel.webp" alt="Interior remodeling services by ProBrothers" loading="lazy" width="750" height="500" />
          </div>
          <div class="card__body">
            <h3>Remodeling</h3>
            <p>Full interior remodeling services to transform any room in your home or business.</p>
            <a href="/services/remodeling/" class="card__link">Learn More <span aria-hidden="true">&#8594;</span></a>
          </div>
        </article>
        <article class="card reveal" style="--d:.1s">
          <div class="card__media">
            <img src="/assets/img/hero-remodel.webp" alt="New construction services by ProBrothers" loading="lazy" width="750" height="500" />
          </div>
          <div class="card__body">
            <h3>Construction Services</h3>
            <p>Quality construction services delivering strength, precision, and lasting craftsmanship.</p>
            <a href="/services/construction-services/" class="card__link">Learn More <span aria-hidden="true">&#8594;</span></a>
          </div>
        </article>
        <article class="card reveal" style="--d:.2s">
          <div class="card__media">
            <img src="/assets/img/svc-windows.webp" alt="Window and door installation by ProBrothers" loading="lazy" width="750" height="500" />
          </div>
          <div class="card__body">
            <h3>Windows &amp; Doors</h3>
            <p>Professional window and door installation and replacement for residential and commercial properties.</p>
            <a href="/services/windows-and-doors/" class="card__link">Learn More <span aria-hidden="true">&#8594;</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== Service Contact Form ===== -->
  <section class="section svc-contact-form" id="quote-form" aria-label="Request an Addition Quote">
    <div class="container">
      <div class="svc-contact-form__wrap reveal">
        <div class="contact-form-box">
          <h2 class="contact-form-box__heading">Contact Us</h2>
          <p class="contact-form-box__sub">We will contact you within two business days.</p>

          <form class="contact-form" id="additionsForm" action="#" method="post" novalidate aria-label="Additions quote form">
            <div class="contact-form__row">
              <div class="contact-form__group">
                <label for="addFirstName">First Name <abbr title="required" aria-label="required">*</abbr></label>
                <div class="contact-form__input-wrap">
                  <input type="text" id="addFirstName" name="firstName" autocomplete="given-name" placeholder="First" required aria-required="true" />
                  <span class="contact-form__line" aria-hidden="true"></span>
                </div>
                <span class="contact-form__error" role="alert" aria-live="polite"></span>
              </div>
              <div class="contact-form__group">
                <label for="addLastName">Last Name <abbr title="required" aria-label="required">*</abbr></label>
                <div class="contact-form__input-wrap">
                  <input type="text" id="addLastName" name="lastName" autocomplete="family-name" placeholder="Last" required aria-required="true" />
                  <span class="contact-form__line" aria-hidden="true"></span>
                </div>
                <span class="contact-form__error" role="alert" aria-live="polite"></span>
              </div>
            </div>

            <div class="contact-form__group">
              <label for="addEmail">Email <abbr title="required" aria-label="required">*</abbr></label>
              <div class="contact-form__input-wrap">
                <input type="email" id="addEmail" name="email" autocomplete="email" placeholder="you@example.com" required aria-required="true" />
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
              <span class="contact-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="contact-form__group">
              <label for="addPhone">Phone</label>
              <div class="contact-form__input-wrap">
                <input type="tel" id="addPhone" name="phone" autocomplete="tel" placeholder="(555) 000-0000" />
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
            </div>

            <div class="contact-form__group">
              <label for="addMessage">Message</label>
              <div class="contact-form__input-wrap">
                <textarea id="addMessage" name="message" rows="5" placeholder="Tell us about your home addition project..."></textarea>
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
            </div>

            <button type="submit" class="btn btn--accent btn--lg contact-form__submit" data-magnetic>Submit</button>

            <div class="contact-form__success" role="status" aria-live="polite" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Your quote request has been submitted successfully. We'll get back to you soon!
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.svc-overview__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.svc-overview__content .section__title { text-align: left; }
.svc-overview__content .section__title + .blueprint { margin-left: 0; }
.svc-overview__content .section__kicker { display: block; }
.svc-overview__para { color: var(--muted); font-size: 1rem; line-height: 1.78; margin: 0 0 1.2rem; }
.svc-overview__para:first-of-type { margin-top: 1.4rem; }
.svc-overview__media { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.svc-overview__figure { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); position: relative; aspect-ratio: 3/4; }
.svc-overview__figure img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .8s var(--ease); }
.svc-overview__figure:hover img { transform: scale(1.04); }
.svc-overview__figure figcaption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: .6rem 1rem;
  background: linear-gradient(to top, rgba(0,0,0,.75), transparent);
  color: #fff; font-weight: 800; font-size: .82rem;
  text-transform: uppercase; letter-spacing: .06em;
  opacity: 0; transform: translateY(8px);
  transition: opacity .35s var(--ease), transform .35s var(--ease);
}
.svc-overview__figure:hover figcaption { opacity: 1; transform: translateY(0); }

.svc-why-trim__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; margin-top: 2rem; }
.svc-why-trim__text p { color: var(--muted); font-size: 1rem; line-height: 1.78; margin-bottom: 1.2rem; }
.svc-testimonial {
  background: #fff; border-radius: var(--radius); padding: 2rem;
  box-shadow: var(--shadow-sm); position: relative;
  transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  border-top: 4px solid var(--accent);
}
.svc-testimonial::before {
  content: "\201C"; position: absolute; top: -18px; left: 18px;
  font-size: 5rem; color: var(--accent);
  font-family: Georgia, serif; line-height: 1; opacity: .55;
}
.svc-testimonial:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
.svc-testimonial .review__stars { color: var(--accent); letter-spacing: .15em; margin-bottom: .8rem; }
.svc-testimonial p { font-size: 1rem; font-style: italic; color: var(--ink); margin-bottom: 1rem; }
.svc-testimonial footer { font-weight: 800; text-transform: uppercase; font-size: .85rem; letter-spacing: .04em; }
.svc-testimonial--center { max-width: 720px; margin: 0 auto; text-align: center; }
.svc-testimonial--center::before { left: 50%; transform: translateX(-50%); }

.svc-types__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; margin-top: 2rem; }
.svc-types__text p { color: var(--muted); font-size: 1rem; line-height: 1.78; margin-bottom: 1.2rem; }
.svc-types__cards { display: flex; flex-direction: column; gap: 1.4rem; }

.faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: .8rem; }
.faq-item { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; border-left: 4px solid var(--accent); }
.faq-item__btn {
  width: 100%; text-align: left; background: none; border: 0; cursor: pointer;
  padding: 1.3rem 1.6rem;
  font-family: 'Raleway', system-ui, sans-serif;
  font-weight: 700; font-size: 1rem; color: var(--dark);
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  transition: color .2s;
}
.faq-item__btn:hover { color: var(--accent); }
.faq-item__icon {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
  background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 1.3rem; font-weight: 900;
  transition: transform .3s var(--ease);
}
.faq-item__btn[aria-expanded="true"] .faq-item__icon { transform: rotate(45deg); }
.faq-item__a { max-height: 0; overflow: hidden; transition: max-height .4s var(--ease), padding .3s; padding: 0 1.6rem; }
.faq-item__a.open { max-height: 400px; padding: 0 1.6rem 1.3rem; }
.faq-item__a p { color: var(--muted); font-size: .95rem; line-height: 1.75; }

@media (max-width: 900px) {
  .svc-overview__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .svc-why-trim__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .svc-types__grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
@media (max-width: 480px) {
  .svc-overview__media { grid-template-columns: 1fr; }
}
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-item__btn').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.faq-item').querySelector('.faq-item__a').classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      btn.closest('.faq-item').querySelector('.faq-item__a').classList.add('open');
    }
  });
});
</script>
