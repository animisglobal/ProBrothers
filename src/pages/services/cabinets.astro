<style>
/* ===== Cabinet Section ===== */
.cab-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.cab-section__grid--reverse {
  direction: rtl;
}
.cab-section__grid--reverse > * {
  direction: ltr;
}
.cab-section__title { text-align: left; }
.cab-section__title + .blueprint { margin-left: 0; }
.cab-section__content .section__kicker { display: block; text-align: left; }
.cab-section__para {
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.78;
  margin: 0 0 1.2rem;
}
.cab-section__para:first-of-type { margin-top: 1.4rem; }
.cab-section__media {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
}
.cab-section__figure {
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  position: relative;
  aspect-ratio: 3/4;
}
.cab-section__figure img {
  width: 100%; height: 100%; display: block;
  object-fit: cover;
  transition: transform .8s var(--ease);
}
.cab-section__figure:hover img { transform: scale(1.04); }
.cab-section__figure figcaption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: .6rem 1rem;
  background: linear-gradient(to top, rgba(0,0,0,.75), transparent);
  color: #fff; font-weight: 800; font-size: .82rem;
  text-transform: uppercase; letter-spacing: .06em;
  opacity: 0; transform: translateY(8px);
  transition: opacity .35s var(--ease), transform .35s var(--ease);
}
.cab-section__figure:hover figcaption { opacity: 1; transform: translateY(0); }

/* ===== Testimonial ===== */
.svc-testimonial {
  background: #fff;
  border-radius: var(--radius);
  padding: 2rem;
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  border-top: 4px solid var(--accent);
  margin-top: 2.5rem;
  max-width: 680px;
}
.svc-testimonial::before {
  content: "\201C";
  position: absolute; top: -18px; left: 18px;
  font-size: 5rem; color: var(--accent);
  font-family: Georgia, serif; line-height: 1; opacity: .55;
}
.svc-testimonial:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
.svc-testimonial .review__stars { color: var(--accent); letter-spacing: .15em; margin-bottom: .8rem; }
.svc-testimonial p { font-size: 1rem; font-style: italic; color: var(--ink); margin-bottom: 1rem; }
.svc-testimonial footer { font-weight: 800; text-transform: uppercase; font-size: .85rem; letter-spacing: .04em; }

/* ===== FAQ ===== */
.faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: .8rem; }
.faq-item {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  border-left: 4px solid var(--accent);
}
.faq-item__btn {
  width: 100%; text-align: left; background: none; border: 0; cursor: pointer;
  padding: 1.3rem 1.6rem;
  font-family: 'Raleway', system-ui, sans-serif;
  font-weight: 700; font-size: 1rem; color: var(--dark);
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  transition: color .2s;
}
.faq-item__btn:hover { color: var(--accent); }
.faq-item__icon {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
  background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 1.3rem; font-weight: 900;
  transition: transform .3s var(--ease);
}
.faq-item__btn[aria-expanded="true"] .faq-item__icon { transform: rotate(45deg); }
.faq-item__a {
  max-height: 0; overflow: hidden;
  transition: max-height .4s var(--ease), padding .3s;
  padding: 0 1.6rem;
}
.faq-item__a.open {
  max-height: 400px;
  padding: 0 1.6rem 1.3rem;
}
.faq-item__a p { color: var(--muted); font-size: .95rem; line-height: 1.75; }

/* ===== Responsive ===== */
@media (max-width: 900px) {
  .cab-section__grid { grid-template-columns: 1fr; gap: 2.5rem; direction: ltr; }
  .cab-section__grid--reverse { direction: ltr; }
}
@media (max-width: 480px) {
  .cab-section__media { grid-template-columns: 1fr; }
}
</style>

<script>
/* FAQ accordion */
document.querySelectorAll('.faq-item__btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-item__btn').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.faq-item').querySelector('.faq-item__a').classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      btn.closest('.faq-item').querySelector('.faq-item__a').classList.add('open');
    }
  });
});
</script>
