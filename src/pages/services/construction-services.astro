---
<Layout
  title="Construction Services in Media, PA | ProBrothers"
  description="Residential & commercial construction in Media, PA. New builds, home renovations & top construction contractors in Pennsylvania. Free quote."
  canonical="https://probrothers.com/services/construction-services/"
  ogTitle="Construction Services in Media, PA | ProBrothers"
  ogDescription="Residential & commercial construction services in Media, PA. New construction & home renovation by ProBrothers."
  ogUrl="https://probrothers.com/services/construction-services/"
  ogImage="https://probrothers.com/assets/img/svc-windows.webp"
  twitterTitle="Construction Services in Media, PA"
  twitterDescription="Residential & commercial construction services in Media, PA. Free quote from ProBrothers."
  twitterImage="https://probrothers.com/assets/img/svc-windows.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp"
          imagesrcset="/assets/img/hero-remodel-sm.webp 800w, /assets/img/hero-remodel.webp 1600w"
          imagesizes="100vw" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
