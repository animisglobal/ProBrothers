      <div class="svc-contact-form__wrap reveal">
        <div class="contact-form-box">
          <h2 class="contact-form-box__heading">Contact Us</h2>
          <p class="contact-form-box__sub">We respect your privacy. Your information will only be used to provide you with a quote.</p>

          <form class="contact-form" id="constructionForm" action="https://api.web3forms.com/submit" method="post" novalidate aria-label="Construction quote form">
            <!-- Web3Forms -->
            <input type="hidden" name="access_key" value="5023493a-aaa6-4fa5-9f80-e594deaa9dec" />
            <input type="hidden" name="subject" value="ProBrothers — Construction quote submission" />
            <input type="hidden" name="from_name" value="ProBrothers Website" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="contact-form__row">
              <div class="contact-form__group">
                <label for="cFirstName">First Name <abbr title="required" aria-label="required">*</abbr></label>
                <div class="contact-form__input-wrap">
                  <input type="text" id="cFirstName" name="firstName" autocomplete="given-name" placeholder="First" required aria-required="true" />
                  <span class="contact-form__line" aria-hidden="true"></span>
                </div>
                <span class="contact-form__error" role="alert" aria-live="polite"></span>
              </div>
              <div class="contact-form__group">
                <label for="cLastName">Last Name <abbr title="required" aria-label="required">*</abbr></label>
                <div class="contact-form__input-wrap">
                  <input type="text" id="cLastName" name="lastName" autocomplete="family-name" placeholder="Last" required aria-required="true" />
                  <span class="contact-form__line" aria-hidden="true"></span>
                </div>
                <span class="contact-form__error" role="alert" aria-live="polite"></span>
              </div>
            </div>

            <div class="contact-form__group">
              <label for="cPhone">Phone</label>
              <div class="contact-form__input-wrap">
                <input type="tel" id="cPhone" name="phone" autocomplete="tel" placeholder="(555) 000-0000" />
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
            </div>

            <div class="contact-form__group">
              <label for="cEmail">Email <abbr title="required" aria-label="required">*</abbr></label>
              <div class="contact-form__input-wrap">
                <input type="email" id="cEmail" name="email" autocomplete="email" placeholder="you@example.com" required aria-required="true" />
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
              <span class="contact-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="contact-form__group">
              <label for="cMessage">Message</label>
              <div class="contact-form__input-wrap">
                <textarea id="cMessage" name="message" rows="5" placeholder="Tell us about your construction project..."></textarea>
                <span class="contact-form__line" aria-hidden="true"></span>
              </div>
            </div>

            <button type="submit" class="btn btn--accent btn--lg contact-form__submit" data-magnetic>Submit</button>

            <div class="contact-form__success" role="status" aria-live="polite" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Your quote request has been submitted successfully. We'll get back to you soon!
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <p class="cta__licence">Licensed &amp; insured Pennsylvania contractor &middot; PA HIC# 195591</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.svc-narrative { max-width: 920px; margin: 2rem auto 0; }
.svc-narrative h3 {
  font-size: 1.35rem; font-weight: 800; color: var(--dark);
  margin: 1.6rem 0 .8rem;
  position: relative; padding-left: 1rem;
  border-left: 4px solid var(--accent);
}
.svc-narrative p { color: var(--muted); font-size: 1rem; line-height: 1.78; margin-bottom: 1.1rem; }
.svc-narrative__cta { text-align: center; color: var(--dark) !important; font-size: 1.1rem !important; margin: 2rem 0 1.4rem; }
.svc-narrative__action { text-align: center; margin-top: 1rem; }

.svc-testimonial {
  background: #fff; border-radius: var(--radius); padding: 2rem;
  box-shadow: var(--shadow-sm); position: relative;
  transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  border-top: 4px solid var(--accent);
}
.svc-testimonial::before {
  content: "\201C"; position: absolute; top: -18px; left: 18px;
  font-size: 5rem; color: var(--accent);
  font-family: Georgia, serif; line-height: 1; opacity: .55;
}
.svc-testimonial:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
.svc-testimonial .review__stars { color: var(--accent); letter-spacing: .15em; margin-bottom: .8rem; }
.svc-testimonial p { font-size: 1rem; font-style: italic; color: var(--ink); margin-bottom: 1rem; }
.svc-testimonial footer { font-weight: 800; text-transform: uppercase; font-size: .85rem; letter-spacing: .04em; }
.svc-testimonial--center { max-width: 720px; margin: 0 auto; text-align: center; }
.svc-testimonial--center::before { left: 50%; transform: translateX(-50%); }

.faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: .8rem; }
.faq-item { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; border-left: 4px solid var(--accent); }
.faq-item__btn {
  width: 100%; text-align: left; background: none; border: 0; cursor: pointer;
  padding: 1.3rem 1.6rem;
  font-family: 'Raleway', system-ui, sans-serif;
  font-weight: 700; font-size: 1rem; color: var(--dark);
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  transition: color .2s;
}
.faq-item__btn:hover { color: var(--accent); }
.faq-item__icon {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
  background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 1.3rem; font-weight: 900;
  transition: transform .3s var(--ease);
}
.faq-item__btn[aria-expanded="true"] .faq-item__icon { transform: rotate(45deg); }
.faq-item__a { max-height: 0; overflow: hidden; transition: max-height .4s var(--ease), padding .3s; padding: 0 1.6rem; }
.faq-item__a.open { max-height: 500px; padding: 0 1.6rem 1.3rem; }
.faq-item__a p { color: var(--muted); font-size: .95rem; line-height: 1.75; }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-item__btn').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.faq-item').querySelector('.faq-item__a').classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      btn.closest('.faq-item').querySelector('.faq-item__a').classList.add('open');
    }
  });
});
</script>
