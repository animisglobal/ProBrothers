---
/**
 * Source URL: https://probrothers.com/services/
 */

import Layout from '../../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://probrothers.com/services/",
      "name": "Our Services",
      "url": "https://probrothers.com/services/",
      "description": "Carpentry, cabinetry, remodeling, additions, construction and windows & doors services in Media, PA from ProBrothers."
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://probrothers.com/services/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://probrothers.com/" },
        { "@type": "ListItem", "position": 2, "name": "Our Services", "item": "https://probrothers.com/services/" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://probrothers.com/services/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long has ProBrothers been in business?",
          "acceptedAnswer": { "@type": "Answer", "text": "With over 15 years of experience, ProBrothers has built a reputation for quality craftsmanship and customer satisfaction in carpentry, remodeling, and construction projects." }
        },
        {
          "@type": "Question",
          "name": "What types of projects can ProBrothers handle?",
          "acceptedAnswer": { "@type": "Answer", "text": "We handle a variety of projects, from small upgrades like crown molding and backsplash installation to larger endeavors such as custom-built home additions, comprehensive remodeling, and new construction. No project is too big or too small!" }
        },
        {
          "@type": "Question",
          "name": "What is your process for starting a project?",
          "acceptedAnswer": { "@type": "Answer", "text": "We begin with a consultation to understand your needs and vision. Then, we provide a custom estimate and design plan. Once approved, we schedule the project and maintain daily communication to ensure everything runs smoothly and on time." }
        },
        {
          "@type": "Question",
          "name": "What sets ProBrothers apart from other Renovation contractors in Pennsylvania?",
          "acceptedAnswer": { "@type": "Answer", "text": "At ProBrothers, we combine over 15 years of experience with a commitment to quality craftsmanship and customer satisfaction. Our team is dedicated to delivering exceptional results, and we prioritize clear communication throughout every project." }
        },
        {
          "@type": "Question",
          "name": "Do you handle both residential and commercial projects?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, ProBrothers offers expert construction and remodeling services for both residential and commercial clients. Whether you're updating your home or enhancing a business property, we have the skills and experience to meet your needs." }
        },
        {
          "@type": "Question",
          "name": "What types of materials do you use for your projects?",
          "acceptedAnswer": { "@type": "Answer", "text": "We use high-quality, durable materials customized to each project. For custom carpentry and woodworking, we offer a range of wood species and finishes. During your consultation, we'll review material options to align with your design goals and budget." }
        }
      ]
    }
  ]
};

const services = [
  { slug: 'trim',                   title: 'TRIM',                  tag: "Elevate Your Home's Aesthetic with Beautiful, Expertly Crafted Trim Work",       img: '/assets/img/hero-trim.webp' },
  { slug: 'cabinets',               title: 'CABINETS',              tag: 'Create Stunning, Functional Spaces with Expertly Designed Custom Cabinets',     img: '/assets/img/services/two-tone-grey-kitchen-1.webp' },
  { slug: 'remodeling',             title: 'REMODELING',            tag: "Unlock Your Home's Potential with our Comprehensive Remodeling Expertise",     img: '/assets/img/svc-remodel.webp' },
  { slug: 'bathroom',               title: 'BATHROOM REMODELING',   tag: 'Gut renovations, tile, vanity & shower upgrades across Delaware County',       img: '/assets/img/svc-remodel.webp' },
  { slug: 'kitchen',                title: 'KITCHEN REMODELING',    tag: 'Custom cabinets, countertops, islands & full kitchen redesign in Media, PA',   img: '/assets/img/services/two-tone-grey-kitchen-2.webp' },
  { slug: 'basement',               title: 'BASEMENT FINISHING',    tag: 'Flooring, drywall, egress windows & custom basement layouts in Delaware County', img: '/assets/img/services/fireplace.webp' },
  { slug: 'additions',              title: 'ADDITIONS',             tag: "Transform Your Home's Potential with Professional, Custom-Built Additions",     img: '/assets/img/hero-remodel.webp' },
  { slug: 'construction-services',  title: 'CONSTRUCTION SERVICES', tag: 'Quality construction services delivering strength, precision, and lasting craftsmanship', img: '/assets/img/svc-cabinets.webp' },
  { slug: 'windows-and-doors',      title: 'WINDOWS & DOORS',       tag: 'Windows & Doors Installation in Media, PA & Surrounding Areas',                 img: '/assets/img/svc-windows.webp' }
];

const locations = [
  { name: 'West Chester, PA',      href: '/locations/west-chester/' },
  { name: 'Media, PA',             href: '/locations/media/' },
  { name: 'Glen Mills, PA',        href: '/locations/glen-mills/' },
  { name: 'Philadelphia, PA',      href: '/locations/philadelphia/' },
  { name: 'Kennett Square, PA',    href: '/locations/kennett-square/' },
  { name: 'Phoenixville, PA',      href: '/locations/phoenixville/' },
  { name: 'Rehoboth, DE',          href: '/locations/rehoboth/' },
  { name: 'Greenville, DE',        href: '/locations/greenville/' },
  { name: 'Malvern, PA',           href: '/locations/malvern/' },
  { name: 'Springfield, PA',       href: '/locations/springfield/' },
  { name: 'Marple, PA',            href: '/locations/marple/' },
  { name: 'Newtown, PA',           href: '/locations/newtown/' },
  { name: 'Nether Providence, PA', href: '/locations/nether-providence/' },
  { name: 'King of Prussia, PA',   href: '/locations/king-of-prussia/' },
  { name: 'Allentown, PA',         href: '/locations/allentown/' }
];
---
<Layout
  title="All Services | General Contractor Media, PA | ProBrothers"
  description="Kitchen & bath remodeling, custom additions, trim, cabinets, windows & construction — all from one licensed Media, PA contractor. Get a free quote today."
  canonical="https://probrothers.com/services/"
  ogTitle="All Services | General Contractor Media, PA | ProBrothers"
  ogDescription="Kitchen & bath remodeling, custom additions, trim, cabinets, windows & construction — all from one licensed Media, PA contractor. Get a free quote today."
  ogUrl="https://probrothers.com/services/"
  ogImage="https://probrothers.com/assets/img/hero-remodel.webp"
  twitterTitle="All Services | General Contractor Media, PA | ProBrothers"
  twitterDescription="Kitchen & bath remodeling, custom additions, trim, cabinets, windows & construction — all from one licensed Media, PA contractor. Get a free quote today."
  twitterImage="https://probrothers.com/assets/img/hero-remodel.webp"
  preloadHero={false}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/hero-remodel.webp" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <!-- ===== Page Banner ===== -->
  <section class="page-banner" aria-labelledby="banner-heading">
    <img class="page-banner__bg"
         src="/assets/img/hero-remodel.webp"
         alt="Construction and remodeling services offered by ProBrothers in Media, PA" fetchpriority="high" width="1600" height="1034" />
    <div class="page-banner__overlay" aria-hidden="true"></div>
    <canvas class="page-banner__particles" id="bannerParticles" aria-hidden="true"></canvas>
    <div class="container page-banner__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page">Our Services</span></li>
        </ol>
      </nav>
      <h1 class="page-banner__title" id="banner-heading">OUR SERVICES</h1>
      <p class="page-banner__sub">ProBrothers &mdash; Carpentry, Cabinetry, Remodeling, Additions, Construction &amp; Windows &amp; Doors</p>
    </div>
    <div class="page-banner__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" focusable="false">
        <path d="M0,35 C360,70 1080,0 1440,45 L1440,70 L0,70 Z" />
      </svg>
    </div>
  </section>

  <!-- ===== Service marquee ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span>Trim</span><i>&#9670;</i><span>Cabinets</span><i>&#9670;</i><span>Remodeling</span><i>&#9670;</i>
        <span>Additions</span><i>&#9670;</i><span>Construction</span><i>&#9670;</i><span>Windows &amp; Doors</span><i>&#9670;</i>
      </span>
    </div>
  </div>

  <!-- ===== Services Grid ===== -->
  <section class="section svc-grid-section" id="services-grid" aria-label="Service Cards">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">WHAT WE OFFER</span>
        <h2 class="section__title">
          OUR SERVICES
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <div class="svc-grid">
        {services.map((s, i) => (
          <a class="svc-grid__card reveal" style={`--d:${i * 0.07}s`} href={`/services/${s.slug}/`}>
            <div class="svc-grid__media">
              <img src={s.img} alt={s.title + ' service by ProBrothers'} loading="lazy" width="600" height="400" />
            </div>
            <div class="svc-grid__body">
              <h3>{s.title}</h3>
              <p>{s.tag}</p>
              <span class="svc-grid__cta">Learn More <span aria-hidden="true">&#8594;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Service Locations ===== -->
  <section class="section svc-locations" id="service-locations" aria-label="Our Service Locations" style="background:var(--gray-2)">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">SERVING PENNSYLVANIA &amp; DELAWARE</span>
        <h2 class="section__title">
          OUR SERVICE LOCATIONS
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <ul class="svc-locations__grid reveal">
        {locations.map(loc => (
          <li>
            <a href={loc.href}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{loc.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Why Choose Us Stats ===== -->
  <section class="section why why-about" id="why-choose-us" aria-label="Why Choose ProBrothers">
    <div class="why__divider" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" focusable="false">
        <path d="M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,45 L1440,0 L0,0 Z" />
      </svg>
    </div>
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker section__kicker--light">The ProBrothers Difference</span>
        <h2 class="section__title section__title--light">WHY CHOOSE US</h2>
      </div>
      <div class="why__grid">
        <div class="why__item reveal">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="why__num" data-count="15">0</div>
          <h3>Years of Professional Experience</h3>
        </div>
        <div class="why__item reveal" style="--d:.12s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="why__num" data-count="135">0</div>
          <h3>Completed Projects and Investments</h3>
        </div>
        <div class="why__item reveal" style="--d:.24s">
          <div class="why__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="why__num" data-count="12">0</div>
          <h3>Skilled Professionals</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section svc-faq" id="faq" aria-label="Frequently Asked Questions">
    <div class="container">
      <div class="section__head reveal">
        <span class="section__kicker">HAVE QUESTIONS?</span>
        <h2 class="section__title">
          FREQUENTLY ASKED QUESTIONS
          <svg class="blueprint" viewBox="0 0 160 24" aria-hidden="true" focusable="false">
            <path d="M0,12 C40,4 80,20 120,10 L160,14" stroke-width="2.5" style="--len:220"/>
            <circle cx="8" cy="12" r="3" style="--len:20"/>
            <circle cx="152" cy="13" r="3" style="--len:20"/>
          </svg>
        </h2>
      </div>
      <dl class="faq-list">
        <div class="faq-item reveal">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              How long has ProBrothers been in business?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>With over 15 years of experience, ProBrothers has built a reputation for quality craftsmanship and customer satisfaction in carpentry, remodeling, and construction projects.</p></dd>
        </div>
        <div class="faq-item reveal" style="--d:.07s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What types of projects can ProBrothers handle?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>We handle a variety of projects, from small upgrades like crown molding and backsplash installation to larger endeavors such as custom-built home additions, comprehensive remodeling, and new construction. No project is too big or too small!</p></dd>
        </div>
        <div class="faq-item reveal" style="--d:.14s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What is your process for starting a project?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>We begin with a consultation to understand your needs and vision. Then, we provide a custom estimate and design plan. Once approved, we schedule the project and maintain daily communication to ensure everything runs smoothly and on time.</p></dd>
        </div>
        <div class="faq-item reveal" style="--d:.21s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What sets ProBrothers apart from other Renovation contractors in Pennsylvania?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>At ProBrothers, we combine over 15 years of experience with a commitment to quality craftsmanship and customer satisfaction. Our team is dedicated to delivering exceptional results, and we prioritize clear communication throughout every project.</p></dd>
        </div>
        <div class="faq-item reveal" style="--d:.28s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              Do you handle both residential and commercial projects?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>Yes, ProBrothers offers expert construction and remodeling services for both residential and commercial clients. Whether you're updating your home or enhancing a business property, we have the skills and experience to meet your needs.</p></dd>
        </div>
        <div class="faq-item reveal" style="--d:.35s">
          <dt class="faq-item__q">
            <button aria-expanded="false" class="faq-item__btn">
              What types of materials do you use for your projects?
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq-item__a"><p>We use high-quality, durable materials customized to each project. For custom carpentry and woodworking, we offer a range of wood species and finishes. During your consultation, we'll review material options to align with your design goals and budget.</p></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="cta" id="contact" aria-label="Contact us">
    <div class="container cta__inner reveal">
      <h2>Ready to Start Your Project?</h2>
      <p>Let's build something you'll love. Reach out for a free, no-obligation custom quote.</p>
      <p class="cta__licence">Licensed &amp; insured Pennsylvania contractor</p>
      <div class="cta__actions">
        <a href="tel:4847454097" class="btn btn--accent btn--lg" data-magnetic>Call (484) 745-4097</a>
        <a href="mailto:info@probrothers.com" class="btn btn--ghost btn--lg" data-magnetic>Email Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.svc-grid-section { padding-top: 3rem; }
.svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; margin-top: 2rem; }
.svc-grid__card {
  display: flex; flex-direction: column;
  background: #fff; border-radius: var(--radius);
  box-shadow: var(--shadow-sm); overflow: hidden;
  text-decoration: none; color: inherit;
  transition: transform .45s var(--ease), box-shadow .45s var(--ease);
  border-top: 4px solid var(--accent);
}
.svc-grid__card:hover { transform: translateY(-10px); box-shadow: var(--shadow); }
.svc-grid__media { aspect-ratio: 3/2; overflow: hidden; }
.svc-grid__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); display: block; }
.svc-grid__card:hover .svc-grid__media img { transform: scale(1.06); }
.svc-grid__body { padding: 1.5rem 1.6rem 1.7rem; display: flex; flex-direction: column; gap: .6rem; }
.svc-grid__body h3 {
  font-size: 1.2rem; font-weight: 900; letter-spacing: .03em;
  color: var(--dark); text-transform: uppercase;
}
.svc-grid__body p { color: var(--muted); font-size: .95rem; line-height: 1.65; flex: 1; }
.svc-grid__cta {
  display: inline-flex; align-items: center; gap: .35rem;
  color: var(--accent); font-weight: 800; font-size: .92rem;
  text-transform: uppercase; letter-spacing: .04em;
  margin-top: .4rem;
}
.svc-grid__cta span { transition: transform .3s var(--ease); }
.svc-grid__card:hover .svc-grid__cta span { transform: translateX(4px); }

.svc-locations__grid {
  list-style: none; padding: 0; margin: 2rem 0 0;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem;
}
.svc-locations__grid a {
  display: flex; align-items: center; gap: .7rem;
  background: #fff; padding: 1rem 1.2rem;
  border-radius: var(--radius); box-shadow: var(--shadow-sm);
  color: var(--dark); text-decoration: none; font-weight: 700;
  border-left: 4px solid var(--accent);
  transition: transform .3s var(--ease), box-shadow .3s var(--ease), color .3s;
}
.svc-locations__grid a:hover { transform: translateX(6px); box-shadow: var(--shadow); color: var(--accent); }
.svc-locations__grid svg { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }

.faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: .8rem; }
.faq-item { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; border-left: 4px solid var(--accent); }
.faq-item__btn {
  width: 100%; text-align: left; background: none; border: 0; cursor: pointer;
  padding: 1.3rem 1.6rem;
  font-family: 'Raleway', system-ui, sans-serif;
  font-weight: 700; font-size: 1rem; color: var(--dark);
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  transition: color .2s;
}
.faq-item__btn:hover { color: var(--accent); }
.faq-item__icon {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
  background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 1.3rem; font-weight: 900;
  transition: transform .3s var(--ease);
}
.faq-item__btn[aria-expanded="true"] .faq-item__icon { transform: rotate(45deg); }
.faq-item__a { max-height: 0; overflow: hidden; transition: max-height .4s var(--ease), padding .3s; padding: 0 1.6rem; }
.faq-item__a.open { max-height: 400px; padding: 0 1.6rem 1.3rem; }
.faq-item__a p { color: var(--muted); font-size: .95rem; line-height: 1.75; }

@media (max-width: 900px) {
  .svc-grid { grid-template-columns: repeat(2, 1fr); }
  .svc-locations__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .svc-grid { grid-template-columns: 1fr; }
  .svc-locations__grid { grid-template-columns: 1fr; }
}
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-item__btn').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.faq-item').querySelector('.faq-item__a').classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      btn.closest('.faq-item').querySelector('.faq-item__a').classList.add('open');
    }
  });
});
</script>
