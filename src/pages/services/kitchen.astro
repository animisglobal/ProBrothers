                 alt="Two-tone kitchen remodel by ProBrothers in Delaware County, PA"
                 loading="lazy" width="480" height="320" />
            <figcaption>Delaware County Kitchen</figcaption>
          </figure>
          <figure class="svc-overview__figure">
            <img src="/assets/img/services/two-tone-grey-kitchen-1.webp"
                 alt="Custom kitchen cabinets and countertops installed by ProBrothers in Media, PA"
                 loading="lazy" width="1024" height="769" />
            <figcaption>Media, PA Kitchen</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Custom Cabinets & Storage ===== -->
